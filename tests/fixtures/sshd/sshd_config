# Base sshd configuration of the courier-ftp e2e image (T76).
#
# The profile (profiles/<name>.conf, copied to /etc/ssh/courier-profile.conf by the
# entrypoint) is included FIRST: for most keywords sshd keeps the first value it
# reads, so a profile overrides anything below. Profiles must not contain `Match`
# blocks. There is no ListenAddress here: sshd listens on 0.0.0.0:22 unless the
# profile names one (maxconn1).
Include /etc/ssh/courier-profile.conf

Port 22
AddressFamily inet
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key
PidFile /run/sshd.pid

# DEBUG1 so the logs show negotiated algorithms; the harness dumps them on failure.
LogLevel DEBUG1

PermitRootLogin no
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no
MaxAuthTries 6
LoginGraceTime 30

AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no

PrintMotd no
PrintLastLog no
UseDNS no
Subsystem sftp internal-sftp
