+    // Implicit: the handshake fails before any greeting.
+    let ui = Ui::new(Ans::Cancel);
+    let cfg = pki.trusted(2, TlsVersions::Tls13Only);
+    let (server, addr) = FakeServer::tcp(vec![Step::StartTlsExpectFailure(cfg)]).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), true);
+    let cancel = token();
+    let r = {
+        let hook = session.implicit(&log, &cancel);
+        ControlConnection::connect(params(addr, &log), Some(&hook), &cancel).await
+    };
+    assert!(matches!(r, Err(Error::Tls(_))), "{:?}", r.map(|_| ()));
