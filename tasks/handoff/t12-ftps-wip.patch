+// ---- trusted certificates (T12) ----
+
+fn trusted(host: &str, fp: u8, added: i64) -> courier_ftp_core::trust::TrustedCert {
+    courier_ftp_core::trust::TrustedCert {
+        host: host.into(),
+        port: 990,
+        sha256: [fp; 32],
+        der: vec![fp; 100],
+        subject: format!("CN={host}"),
+        issuer: "CN=Test CA".into(),
+        not_after: time::OffsetDateTime::from_unix_timestamp(1_900_000_000).unwrap(),
+        added_at: time::OffsetDateTime::from_unix_timestamp(added).unwrap(),
+    }
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn vault_cert_store_roundtrip_and_replace() {
+    use courier_ftp_core::model::item::TrustedCertItem;
+    use courier_ftp_core::trust::CertTrustStore;
+    use courier_ftp_core::vault::VaultCertTrustStore;
+
+    let dir = tempfile::tempdir().unwrap();
+    let e = engine(&db(&dir), MemKeyring::new()).await;
+    e.initialize(pw(PASSWORD), false).await.unwrap();
+    let store = VaultCertTrustStore::new(e.clone());
+    assert!(store.is_persistent());
+    let first = trusted("FTP.Example.org", 1, 1_700_000_000);
+    store.add(first.clone()).await.unwrap();
+    let found = store.lookup("ftp.example.ORG", 990).await.unwrap();
+    assert_eq!(found.len(), 1);
+    let mut want = first.clone();
+    want.host = "ftp.example.org".into();
+    assert_eq!(found[0], want, "round trip");
+    let ids = e.item_ids(ItemKind::TrustedCert).unwrap();
+    assert_eq!(ids.len(), 1);
+
+    // A changed certificate replaces the entry in the same item.
+    let second = trusted("ftp.example.org", 2, 1_700_000_100);
+    store.add(second.clone()).await.unwrap();
+    assert_eq!(e.item_ids(ItemKind::TrustedCert).unwrap(), ids);
+    let found = store.lookup("ftp.example.org", 990).await.unwrap();
+    assert_eq!(found, vec![second.clone()]);
+    let items = e.list::<TrustedCertItem>().unwrap();
+    assert_eq!(items[0].view.sha256, [2; 32]);
+    assert_eq!(items[0].view.cert_der, vec![2; 100]);
+
+    // Other host: second item; list is sorted.
+    store.add(trusted("a.example", 3, 1)).await.unwrap();
+    let all = store.list().await.unwrap();
+    assert_eq!(
+        all.iter().map(|c| c.host.as_str()).collect::<Vec<_>>(),
+        vec!["a.example", "ftp.example.org"]
+    );
+
+    // Remove: wrong fingerprint is a no-op.
+    store
+        .remove("ftp.example.org", 990, &[1; 32])
+        .await
+        .unwrap();
+    assert_eq!(store.lookup("ftp.example.org", 990).await.unwrap().len(), 1);
+    store
+        .remove("ftp.example.org", 990, &[2; 32])
+        .await
+        .unwrap();
+    assert!(
+        store
+            .lookup("ftp.example.org", 990)
+            .await
+            .unwrap()
+            .is_empty()
+    );
+
+    // Persisted across lock/unlock.
+    e.lock(LockReason::Manual).await;
+    assert!(matches!(
+        store.lookup("a.example", 990).await,
+        Err(courier_ftp_core::Error::VaultLocked)
+    ));
+    assert!(matches!(
+        store.add(trusted("b.example", 4, 1)).await,
+        Err(courier_ftp_core::Error::VaultLocked)
+    ));
+    e.unlock(pw(PASSWORD)).await.unwrap();
+    assert_eq!(store.lookup("a.example", 990).await.unwrap().len(), 1);
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn cert_store_switch_follows_unlock_and_lock() {
+    use courier_ftp_core::trust::{CertTrustStore, MemoryCertTrustStore, SwitchableCertTrustStore};
+    use courier_ftp_core::vault::spawn_cert_store_switch;
+
+    let dir = tempfile::tempdir().unwrap();
+    let e = engine(&db(&dir), MemKeyring::new()).await;
+    let switch = Arc::new(SwitchableCertTrustStore::new(Arc::new(
+        MemoryCertTrustStore::new(),
+    )));
+    let task = spawn_cert_store_switch(e.clone(), Arc::clone(&switch));
+    assert!(!switch.is_persistent());
+    e.initialize(pw(PASSWORD), false).await.unwrap();
+    wait_for(|| switch.is_persistent()).await;
+    switch.add(trusted("h", 5, 1)).await.unwrap();
+    assert_eq!(e.item_ids(ItemKind::TrustedCert).unwrap().len(), 1);
+
+    e.lock(LockReason::Manual).await;
+    wait_for(|| !switch.is_persistent()).await;
+    assert!(switch.lookup("h", 990).await.unwrap().is_empty());
+
+    e.unlock(pw(PASSWORD)).await.unwrap();
+    wait_for(|| switch.is_persistent()).await;
+    assert_eq!(switch.lookup("h", 990).await.unwrap().len(), 1);
+
+    // Started while unlocked: points at the vault at once.
+    let other = Arc::new(SwitchableCertTrustStore::new(Arc::new(
+        MemoryCertTrustStore::new(),
+    )));
+    let task2 = spawn_cert_store_switch(e.clone(), Arc::clone(&other));
+    assert!(other.is_persistent());
+    task.abort();
+    task2.abort();
+}
+
+async fn wait_for(mut f: impl FnMut() -> bool) {
+    for _ in 0..500 {
+        if f() {
+            return;
+        }
+        tokio::time::sleep(Duration::from_millis(10)).await;
+    }
+    panic!("condition not reached");
+}
