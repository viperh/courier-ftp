+#[tokio::test]
+async fn reuse_required_with_tls13_reconnects_with_tls12() {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let cfg = pki.trusted(2, TlsVersions::Both);
+    let gate = memory_gate();
+
+    // First connection: TLS 1.3; the server refuses the data connection.
+    let steps = script(vec![
+        explicit(&cfg),
+        login_steps(),
+        prot_p(),
+        vec![
+            Step::DataTls(Some((Arc::clone(&cfg), DataTlsCheck::RejectTls13))),
+            Step::Expect("TYPE I"),
+            Step::Reply("200 Switching to Binary mode."),
+            Step::EpsvListen,
+            Step::Expect("RETR f.bin"),
+            Step::Reply("150 Opening BINARY mode data connection."),
+            Step::DataHandshake,
+            Step::Reply("522 SSL connection failed: session reuse required"),
+        ],
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&gate, false);
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    assert_eq!(session.info().unwrap().protocol, "TLSv1.3");
+    let err = download(&mut ctrl, &session.data_hook(), "f.bin")
+        .await
+        .unwrap_err();
+    assert!(
+        matches!(
+            &err,
+            Error::Protocol {
+                code: Some(522),
+                ..
+            }
+        ),
+        "{err:?}"
+    );
+    assert_eq!(session.check_data_error(err).unwrap_err(), TlsReuseRequired);
+    let t = done(ctrl, server).await;
+    assert_eq!(t.data_tls, vec![("TLSv1.3".to_owned(), true)]);
+    assert!(gate.is_tls12_only("fake.test", 21));
+
+    // T14 reconnects with a new session: TLS 1.2 only; the transfer succeeds.
+    let steps = script(vec![
+        explicit(&cfg),
+        login_steps(),
+        prot_p(),
+        serve_tls(&cfg, DataTlsCheck::RejectTls13, "RETR f.bin", 5000),
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let mut session = pki.session(&gate, false);
+    assert!(session.is_tls12_only(), "the hint is remembered");
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    assert_eq!(session.info().unwrap().protocol, "TLSv1.2");
+    let got = download(&mut ctrl, &session.data_hook(), "f.bin")
+        .await
+        .unwrap();
+    assert_eq!(got, pattern_bytes(0, 5000));
+    let t = done(ctrl, server).await;
+    assert_eq!(t.data_tls, vec![("TLSv1.2".to_owned(), true)]);
+    assert!(
+        ui.lines(LogKind::Status)
+            .await
+            .contains(&REUSE_RECONNECT_STATUS.to_owned())
+    );
+    // Later connections to that host:port start with TLS 1.2.
+    assert!(pki.session(&gate, false).is_tls12_only());
+}
