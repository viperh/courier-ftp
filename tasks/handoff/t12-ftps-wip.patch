+        control_host: ftpd.host(),
+        timeout: Duration::from_secs(20),
+        socket_buffer: DEFAULT_SOCKET_BUFFER,
+    }
+}
+
+/// Plays the UI: answers certificate prompts with `answer` and records them.
+struct Ui {
+    log: SessionLog,
+    prompts: Arc<Mutex<Vec<CertPromptDetails>>>,
+    _task: tokio::task::JoinHandle<()>,
+}
+
+impl Ui {
+    fn new(answer: TrustAnswer) -> Self {
+        let (events, mut rx) = channel(DebugLevel::Debug);
+        let prompts = Arc::new(Mutex::new(Vec::new()));
+        let seen = Arc::clone(&prompts);
+        let task = tokio::spawn(async move {
+            while let Some(event) = rx.recv().await {
+                if let CoreEvent::Prompt(req) = event {
+                    if let PromptKind::TrustCertificate(d) = &req.kind {
+                        seen.lock().unwrap().push((**d).clone());
+                        req.respond(PromptResponse::Certificate(answer));
+                    } else {
+                        req.respond(PromptResponse::Cancel);
+                    }
+                }
+            }
+        });
+        Self {
+            log: SessionLog {
+                events,
+                session: SessionId::next(),
+            },
+            prompts,
+            _task: task,
+        }
+    }
+
+    fn prompts(&self) -> Vec<CertPromptDetails> {
+        self.prompts.lock().unwrap().clone()
+    }
+}
+
+fn roots() -> RootSource {
+    RootSource::custom_from_der([TlsFixture::ca_der().unwrap()]).unwrap()
+}
+
+fn encryption(profile: FtpdProfile) -> FtpEncryption {
+    if profile == FtpdProfile::VsftpdImplicitTls {
+        FtpEncryption::RequireImplicit
+    } else {
+        FtpEncryption::RequireExplicit
+    }
+}
+
+/// Connect (implicit or explicit TLS), login, `PBSZ`/`PROT P`, negotiate.
+async fn connect(
+    ftpd: &Ftpd,
+    gate: &Arc<TlsTrustGate>,
+    ui: &Ui,
+) -> Result<(ControlConnection, TlsSession), Error> {
+    let profile = ftpd.profile();
+    let port = profile.control_port();
+    let mode = encryption(profile);
+    let mut session = TlsSession::new(&ftpd.host(), port, roots(), false, Arc::clone(gate))?;
+    let p = ControlParams {
+        target: HostPort::new(ftpd.host(), port),
+        server_name: ftpd.host(),
+        net: net_opts(Purpose::Control),
+        charset: Charset::Auto,
+        timeout: Duration::from_secs(20),
+        keepalive_command: KeepaliveCommand::Noop,
+        log: ui.log.clone(),
+    };
+    let cancel = CancellationToken::new();
+    let mut conn = if mode == FtpEncryption::RequireImplicit {
+        let hook = session.implicit(&ui.log, &cancel);
+        ControlConnection::connect(p, Some(&hook), &cancel).await?.0
+    } else {
+        ControlConnection::connect(p, None, &cancel).await?.0
+    };
+    assert!(start_tls(&mut conn, &mut session, mode, &cancel).await?);
+    let info = LoginPromptInfo {
+        target: format!("{USER}@{}", ftpd.host()),
+        cache_key: SecretCacheKey::Password {
+            protocol: Protocol::Ftp,
+            host: ftpd.host(),
+            port,
+            user: USER.into(),
+        },
+        can_save: false,
+    };
+    let logon = LogonType::Normal {
+        password: Some(SecretString::from(PASSWORD)),
+    };
+    conn.login(LoginScript::for_logon(Some(USER), &logon, info)?, &cancel)
+        .await?;
+    protect_data(&mut conn, &mut session, mode, &cancel).await?;
+    conn.negotiate(&cancel).await?;
+    Ok((conn, session))
+}
+
+fn test_bytes(len: usize) -> Vec<u8> {
+    (0..len as u64)
+        .map(|i| (i.wrapping_mul(2_654_435_761) >> 11) as u8)
+        .collect()
+}
+
+fn sha(bytes: &[u8]) -> String {
+    sha256_reader(bytes).unwrap()
+}
+
+/// LIST + upload + download on one session.
+async fn transfers(
+    ftpd: &Ftpd,
+    conn: &mut ControlConnection,
+    session: &TlsSession,
+    name: &str,
+) -> Result<(), Error> {
+    let cfg = data_cfg(ftpd);
+    let mut state = DataState::default();
+    let hook = session.data_hook();
+    let cancel = CancellationToken::new();
+    let mut d = FtpData {
+        ctrl: conn,
+        cfg: &cfg,
+        state: &mut state,
+    };
+    let listing = d
+        .read_listing(TransferCommand::List { args: None }, Some(&hook), &cancel)
+        .await?;
+    let listing = String::from_utf8_lossy(&listing);
+    assert!(listing.contains("upload"), "{listing}");
+
+    let bytes = test_bytes(ONE_MIB);
+    let remote = format!("/upload/{name}");
+    let cmd = TransferCommand::Stor {
+        path: remote.clone(),
+        offset: 0,
+    };
+    let mut s = d
+        .open(cmd, TransferType::Binary, Some(&hook), &cancel)
+        .await?;
+    s.write_all(&bytes).await?;
+    d.finish(Some(s), &cancel).await?;
+    let on_server = ftpd
+        .sha256_of(&format!("/home/{USER}/upload/{name}"))
+        .await
+        .unwrap();
+    assert_eq!(on_server, sha(&bytes), "uploaded file");
+
+    let cmd = TransferCommand::Retr {
+        path: remote,
+        offset: 0,
+        range_len: None,
+    };
+    let mut s = d
+        .open(cmd, TransferType::Binary, Some(&hook), &cancel)
+        .await?;
+    let mut back = Vec::new();
+    s.read_to_end(&mut back).await?;
+    d.finish(Some(s), &cancel).await?;
+    assert_eq!(sha(&back), sha(&bytes), "downloaded file");
+    Ok(())
+}
+
+/// What T14 does: one reconnect with TLS 1.2 when the server requires session reuse
+/// that failed under TLS 1.3.
+async fn roundtrip(profile: FtpdProfile, name: &str) {
+    let ftpd = Ftpd::start(profile).await.unwrap();
+    let ui = Ui::new(TrustAnswer::Reject);
+    let gate = TlsTrustGate::new(Arc::new(MemoryCertTrustStore::new()));
+    let (mut conn, session) = connect(&ftpd, &gate, &ui).await.unwrap();
+    let info = session.info().unwrap().clone();
+    assert_eq!(info.trusted_by, TrustSource::Platform, "{}", profile.name());
+    assert!(!info.cipher_suite.is_empty());
+    match transfers(&ftpd, &mut conn, &session, name).await {
+        Ok(()) => conn.quit().await,
+        Err(e) => {
+            let reuse = match session.check_data_error(e) {
+                Ok(e) => panic!("{}: transfer failed: {e:?}", profile.name()),
+                Err(reuse) => reuse,
+            };
+            eprintln!("{}: {reuse}", profile.name());
+            conn.quit().await;
+            let (mut conn, session) = connect(&ftpd, &gate, &ui).await.unwrap();
+            assert!(session.is_tls12_only());
+            transfers(&ftpd, &mut conn, &session, name).await.unwrap();
+            conn.quit().await;
+        }
+    }
+    assert!(ui.prompts().is_empty(), "CA-signed: no prompt");
+}
