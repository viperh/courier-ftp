index 0000000..0042bad
--- /dev/null
+++ b/crates/courier-ftp-proto-ftp/src/tls/details.rs
@@ -0,0 +1,208 @@
+//! Certificate details for the trust prompt and the server-info dialog (T12 §4, T69):
+//! X.509 fields via `x509-parser`, fingerprints, and the mapping of rustls verifier
+//! errors to [`CertProblem`].
+//!
+//! Server certificates are untrusted input: parsing is bounded ([`MAX_PARSE_DER`]),
+//! never fails the connection on its own (the fingerprints are always filled), and
+//! every display string has its control characters replaced.
+
+use std::net::IpAddr;
+
+use courier_ftp_core::events::{CertProblem, CertificateDetails};
+use rustls::CertificateError;
+use sha1::Sha1;
+use sha2::{Digest as _, Sha256};
+use time::OffsetDateTime;
+use x509_parser::{
+    certificate::X509Certificate, der_parser::oid::Oid, extensions::GeneralName,
+    prelude::FromDer as _, public_key::PublicKey,
+};
+
+/// Certificates larger than this are not parsed (fingerprints only).
+pub const MAX_PARSE_DER: usize = 64 * 1024;
+
+/// SHA-256 of `der`.
+pub fn sha256(der: &[u8]) -> [u8; 32] {
+    Sha256::digest(der).into()
+}
+
+/// SHA-1 of `der` (display only).
+pub fn sha1(der: &[u8]) -> [u8; 20] {
+    Sha1::digest(der).into()
+}
+
+/// Upper-case hex with `:` separators (`AB:CD:…`), the fingerprint display format.
+pub fn fingerprint_hex(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len() * 3);
+    for (i, b) in bytes.iter().enumerate() {
+        if i > 0 {
+            out.push(':');
+        }
+        out.push_str(&format!("{b:02X}"));
+    }
+    out
+}
+
+/// Replaces control characters (C0, DEL, C1) with U+FFFD.
+pub(crate) fn clean(text: &str) -> String {
+    text.chars()
+        .map(|c| if c.is_control() { '\u{FFFD}' } else { c })
+        .collect()
+}
+
+fn empty(der: &[u8], error: String) -> CertificateDetails {
+    CertificateDetails {
+        subject: String::new(),
+        subject_cn: None,
+        issuer: String::new(),
+        serial: String::new(),
+        not_before: OffsetDateTime::UNIX_EPOCH,
+        not_after: OffsetDateTime::UNIX_EPOCH,
+        sha256: sha256(der),
+        sha1: sha1(der),
+        sans: Vec::new(),
+        public_key: String::new(),
+        signature_algorithm: String::new(),
+        is_ca: false,
+        self_signed: false,
+        parse_error: Some(error),
+    }
+}
+
+/// Parses one DER certificate. Never fails: on a parse error the fingerprints are set,
+/// the other fields are empty and `parse_error` says why.
+pub fn certificate_details(der: &[u8]) -> CertificateDetails {
+    if der.len() > MAX_PARSE_DER {
+        return empty(
+            der,
+            format!("certificate larger than {MAX_PARSE_DER} bytes"),
+        );
+    }
+    let cert = match X509Certificate::from_der(der) {
+        Ok((_, cert)) => cert,
+        Err(e) => return empty(der, clean(&e.to_string())),
+    };
+    let mut parse_error = None;
+    let sans = match cert.subject_alternative_name() {
+        Ok(Some(ext)) => ext.value.general_names.iter().filter_map(san).collect(),
+        Ok(None) => Vec::new(),
+        Err(e) => {
+            parse_error = Some(clean(&format!("subject alternative names: {e}")));
+            Vec::new()
+        }
+    };
+    let subject_cn = cert
+        .subject()
+        .iter_common_name()
+        .next()
+        .and_then(|cn| cn.as_str().ok())
+        .map(clean);
+    let same_name = cert.subject().as_raw() == cert.issuer().as_raw();
+    CertificateDetails {
+        subject: clean(&cert.subject().to_string()),
+        subject_cn,
+        issuer: clean(&cert.issuer().to_string()),
+        serial: fingerprint_hex(cert.raw_serial()),
+        not_before: cert.validity().not_before.to_datetime(),
+        not_after: cert.validity().not_after.to_datetime(),
+        sha256: sha256(der),
+        sha1: sha1(der),
+        sans,
+        public_key: public_key_name(&cert),
+        signature_algorithm: signature_name(&cert.signature_algorithm.algorithm),
+        is_ca: cert.is_ca(),
+        self_signed: same_name && cert.verify_signature(None).is_ok(),
+        parse_error,
+    }
+}
+
+fn san(name: &GeneralName<'_>) -> Option<String> {
+    Some(match name {
+        GeneralName::DNSName(d) => format!("DNS:{}", clean(d)),
+        GeneralName::IPAddress(bytes) => {
+            let ip = match bytes.len() {
+                4 => IpAddr::from(<[u8; 4]>::try_from(*bytes).ok()?),
+                16 => IpAddr::from(<[u8; 16]>::try_from(*bytes).ok()?),
+                _ => return None,
+            };
+            format!("IP:{ip}")
+        }
+        GeneralName::RFC822Name(m) => format!("email:{}", clean(m)),
+        GeneralName::URI(u) => format!("URI:{}", clean(u)),
+        _ => return None,
+    })
+}
+
+fn public_key_name(cert: &X509Certificate<'_>) -> String {
+    let spki = cert.public_key();
+    let alg = spki.algorithm.algorithm.to_id_string();
+    match alg.as_str() {
+        "1.3.101.112" => return "Ed25519".into(),
+        "1.3.101.113" => return "Ed448".into(),
+        _ => {}
+    }
+    match spki.parsed() {
+        Ok(PublicKey::RSA(rsa)) => format!("RSA {}", rsa.key_size()),
+        Ok(PublicKey::EC(_)) => {
+            let curve = spki
+                .algorithm
+                .parameters
+                .as_ref()
+                .and_then(|p| p.as_oid().ok())
+                .map(|o| o.to_id_string());
+            match curve.as_deref() {
+                Some("1.2.840.10045.3.1.7") => "EC P-256".into(),
+                Some("1.3.132.0.34") => "EC P-384".into(),
+                Some("1.3.132.0.35") => "EC P-521".into(),
+                Some(other) => format!("EC {other}"),
+                None => "EC".into(),
+            }
+        }
+        Ok(PublicKey::DSA(y)) => format!("DSA {}", y.len() * 8),
+        _ => alg,
+    }
+}
+
+fn signature_name(oid: &Oid<'_>) -> String {
+    let id = oid.to_id_string();
+    let name = match id.as_str() {
+        "1.2.840.113549.1.1.5" => "sha1WithRSAEncryption",
+        "1.2.840.113549.1.1.10" => "RSASSA-PSS",
+        "1.2.840.113549.1.1.11" => "sha256WithRSAEncryption",
+        "1.2.840.113549.1.1.12" => "sha384WithRSAEncryption",
+        "1.2.840.113549.1.1.13" => "sha512WithRSAEncryption",
+        "1.2.840.10045.4.1" => "ecdsa-with-SHA1",
+        "1.2.840.10045.4.3.2" => "ecdsa-with-SHA256",
+        "1.2.840.10045.4.3.3" => "ecdsa-with-SHA384",
+        "1.2.840.10045.4.3.4" => "ecdsa-with-SHA512",
+        "1.3.101.112" => "Ed25519",
+        "1.3.101.113" => "Ed448",
+        _ => return id,
+    };
+    name.to_owned()
+}
+
+/// Maps a verifier error to the prompt's problem. `UnknownIssuer` becomes `SelfSigned`
+/// when the leaf's subject equals its issuer.
+pub fn cert_problem(err: &rustls::Error, self_issued: bool) -> CertProblem {
+    let rustls::Error::InvalidCertificate(ce) = err else {
+        return CertProblem::Other(clean(&err.to_string()));
+    };
+    match ce {
+        CertificateError::UnknownIssuer if self_issued => CertProblem::SelfSigned,
+        CertificateError::UnknownIssuer => CertProblem::UnknownIssuer,
+        CertificateError::Expired | CertificateError::ExpiredContext { .. } => CertProblem::Expired,
+        CertificateError::NotValidYet | CertificateError::NotValidYetContext { .. } => {
+            CertProblem::NotYetValid
+        }
+        CertificateError::NotValidForName | CertificateError::NotValidForNameContext { .. } => {
+            CertProblem::NotValidForName
+        }
+        CertificateError::Revoked => CertProblem::Revoked,
+        CertificateError::InvalidPurpose | CertificateError::InvalidPurposeContext { .. } => {
+            CertProblem::InvalidPurpose
+        }
+        CertificateError::BadSignature => CertProblem::BadSignature,
+        _ => CertProblem::Other(clean(&err.to_string())),
+    }
+}
