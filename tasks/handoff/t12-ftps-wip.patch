+
+// ---- certificates (T12) ----
+
+fn cert(host: &str, port: u16, fp: u8, added: i64) -> TrustedCert {
+    TrustedCert {
+        host: host.to_owned(),
+        port,
+        sha256: [fp; 32],
+        der: vec![fp; 8],
+        subject: format!("CN={host}"),
+        issuer: "CN=Test CA".into(),
+        not_after: OffsetDateTime::from_unix_timestamp(2_000_000_000).unwrap(),
+        added_at: OffsetDateTime::from_unix_timestamp(added).unwrap(),
+    }
+}
+
+#[tokio::test]
+async fn memory_store_add_replaces_same_host_port() {
+    let store = MemoryCertTrustStore::persistent_for_tests();
+    store.add(cert("FTP.example.com", 21, 1, 10)).await.unwrap();
+    store
+        .add(cert("ftp.example.com", 990, 2, 10))
+        .await
+        .unwrap();
+    store.add(cert("ftp.example.com", 21, 3, 20)).await.unwrap();
+    let hits = store.lookup("Ftp.Example.com", 21).await.unwrap();
+    assert_eq!(hits.len(), 1);
+    assert_eq!(hits[0].sha256, [3; 32]);
+    assert_eq!(hits[0].host, "ftp.example.com");
+    let all = store.list().await.unwrap();
+    assert_eq!(
+        all.iter().map(|c| c.port).collect::<Vec<_>>(),
+        vec![21, 990]
+    );
+    // Wrong fingerprint: no-op; right one: removed.
+    store.remove("ftp.example.com", 21, &[1; 32]).await.unwrap();
+    assert_eq!(store.lookup("ftp.example.com", 21).await.unwrap().len(), 1);
+    store.remove("ftp.example.com", 21, &[3; 32]).await.unwrap();
+    assert!(
+        store
+            .lookup("ftp.example.com", 21)
+            .await
+            .unwrap()
+            .is_empty()
+    );
+}
+
+#[test]
+fn memory_store_is_not_persistent() {
+    assert!(!MemoryCertTrustStore::new().is_persistent());
+    assert!(MemoryCertTrustStore::persistent_for_tests().is_persistent());
+}
+
+#[tokio::test]
+async fn switchable_store_delegates_to_current() {
+    let first: Arc<dyn CertTrustStore> = Arc::new(MemoryCertTrustStore::new());
+    let second: Arc<dyn CertTrustStore> = Arc::new(MemoryCertTrustStore::persistent_for_tests());
+    let switch = SwitchableCertTrustStore::new(Arc::clone(&first));
+    assert!(!switch.is_persistent());
+    switch.add(cert("a", 21, 1, 0)).await.unwrap();
+    assert_eq!(first.list().await.unwrap().len(), 1);
+    switch.set(Arc::clone(&second));
+    assert!(switch.is_persistent());
+    assert!(switch.lookup("a", 21).await.unwrap().is_empty());
+    switch.add(cert("b", 21, 2, 0)).await.unwrap();
+    assert_eq!(second.list().await.unwrap().len(), 1);
+    switch.remove("b", 21, &[2; 32]).await.unwrap();
+    assert!(second.list().await.unwrap().is_empty());
+    assert!(format!("{switch:?}").contains("MemoryCertTrustStore"));
+}
+
+#[test]
+fn trusted_cert_to_previous() {
+    let c = cert("a", 21, 7, 5);
+    let p = c.to_previous();
+    assert_eq!(p.sha256, [7; 32]);
+    assert_eq!(p.subject, "CN=a");
+    assert_eq!(p.added_at, c.added_at);
+    assert_eq!(p.not_after, c.not_after);
+}
diff --git a/crates/courier-ftp-core/src/vault/cert_trust.rs b/crates/courier-ftp-core/src/vault/cert_trust.rs
new file mode 100644
index 0000000..9c3454f
--- /dev/null
+++ b/crates/courier-ftp-core/src/vault/cert_trust.rs
@@ -0,0 +1,190 @@
+//! T12's [`CertTrustStore`] on `trusted-cert` vault items (T81 [`TrustedCertItem`]) and
+//! the task that points the FTPS verifier's [`SwitchableCertTrustStore`] at it while
+//! the vault is unlocked.
+//!
+//! One item per (host, port): "Always trust" of a changed certificate rewrites the
+//! existing item (same `ItemId`) instead of adding a second one.
+
+use std::sync::{Arc, Weak};
+
+use async_trait::async_trait;
+use time::OffsetDateTime;
+use tokio::sync::broadcast::error::RecvError;
+
+use super::engine::{Inner, VaultEngine};
+use super::{Loaded, VaultChange, VaultState};
+use crate::Result;
+use crate::model::item::{ItemId, ItemView, MAX_CERT_DER, TrustedCertItem, UnixMillis};
+use crate::trust::{
+    CertTrustStore, MemoryCertTrustStore, SwitchableCertTrustStore, TrustedCert, normalize_host,
+};
+
+fn to_millis(t: OffsetDateTime) -> UnixMillis {
+    UnixMillis(i64::try_from(t.unix_timestamp_nanos() / 1_000_000).unwrap_or(0))
+}
+
+fn from_millis(ms: UnixMillis) -> OffsetDateTime {
+    OffsetDateTime::from_unix_timestamp_nanos(i128::from(ms.0) * 1_000_000)
+        .unwrap_or(OffsetDateTime::UNIX_EPOCH)
+}
+
+fn trusted_cert(item: TrustedCertItem) -> TrustedCert {
+    TrustedCert {
+        host: normalize_host(&item.host),
+        port: item.port,
+        sha256: item.sha256,
+        der: item.cert_der,
+        subject: item.subject,
+        issuer: item.issuer,
+        not_after: from_millis(item.not_after),
+        added_at: from_millis(item.added_at),
+    }
+}
+
+fn cert_item(cert: TrustedCert) -> TrustedCertItem {
+    let mut der = cert.der;
+    // The item refuses larger DER; the fingerprint alone still pins the certificate.
+    if der.len() > MAX_CERT_DER {
+        der.clear();
+    }
+    TrustedCertItem {
+        host: normalize_host(&cert.host),
+        port: cert.port,
+        sha256: cert.sha256,
+        cert_der: der,
+        subject: cert.subject,
+        issuer: cert.issuer,
+        not_after: to_millis(cert.not_after),
+        added_at: to_millis(cert.added_at),
+    }
+}
+
+/// `CertTrustStore` on `trusted-cert` items of the vault ([`TrustedCertItem`]).
+/// `VaultError::Locked` surfaces as `Error::VaultLocked`.
+#[derive(Debug, Clone)]
+pub struct VaultCertTrustStore {
+    engine: VaultEngine,
+}
+
+impl VaultCertTrustStore {
+    /// A store over `engine` (which must be unlocked for the calls to succeed).
+    pub fn new(engine: VaultEngine) -> Self {
+        Self { engine }
+    }
+
+    fn matching(&self, host: &str, port: u16) -> Result<Vec<Loaded<TrustedCertItem>>> {
+        let host = normalize_host(host);
+        Ok(self
+            .engine
+            .list::<TrustedCertItem>()?
+            .into_iter()
+            .filter(|l| l.view.matches(&host, port))
+            .collect())
+    }
+}
+
+#[async_trait]
+impl CertTrustStore for VaultCertTrustStore {
+    async fn lookup(&self, host: &str, port: u16) -> Result<Vec<TrustedCert>> {
+        Ok(self
+            .matching(host, port)?
+            .into_iter()
+            .map(|l| trusted_cert(l.view))
+            .collect())
+    }
+
+    async fn add(&self, cert: TrustedCert) -> Result<()> {
+        let existing = self.matching(&cert.host, cert.port)?;
+        let item = cert_item(cert);
+        let mut existing = existing.into_iter();
+        match existing.next() {
+            Some(first) => {
+                self.engine.put(first.vault, first.id, item).await?;
+                // Duplicates (e.g. written by two devices before a sync) are dropped.
+                let rest: Vec<ItemId> = existing.map(|l| l.id).collect();
+                if !rest.is_empty() {
+                    self.engine.delete_many(rest).await?;
+                }
+            }
+            None => {
+                let vault = self.engine.personal_vault()?;
+                self.engine.put(vault, ItemId::new(), item).await?;
+            }
+        }
+        tracing::debug!(
+            kind = TrustedCertItem::KIND.as_str(),
+            "trusted certificate stored"
+        );
+        Ok(())
+    }
+
+    async fn list(&self) -> Result<Vec<TrustedCert>> {
+        let mut all: Vec<TrustedCert> = self
+            .engine
+            .list::<TrustedCertItem>()?
+            .into_iter()
+            .map(|l| trusted_cert(l.view))
+            .collect();
+        all.sort_by(|a, b| (&a.host, a.port).cmp(&(&b.host, b.port)));
+        Ok(all)
+    }
+
+    async fn remove(&self, host: &str, port: u16, sha256: &[u8; 32]) -> Result<()> {
+        let ids: Vec<ItemId> = self
+            .matching(host, port)?
+            .into_iter()
+            .filter(|l| &l.view.sha256 == sha256)
+            .map(|l| l.id)
+            .collect();
+        if !ids.is_empty() {
+            self.engine.delete_many(ids).await?;
+        }
+        Ok(())
+    }
+
+    fn is_persistent(&self) -> bool {
+        true
+    }
+}
+
+fn point_at(inner: &Weak<Inner>, unlocked: bool, switch: &SwitchableCertTrustStore) {
+    let engine = inner.upgrade().map(VaultEngine::from_inner);
+    match engine {
+        Some(engine) if unlocked => switch.set(Arc::new(VaultCertTrustStore::new(engine))),
+        _ => switch.set(Arc::new(MemoryCertTrustStore::new())),
+    }
+}
+
+/// Keeps `switch` pointing at the vault store while unlocked: listens to
+/// [`VaultEngine::subscribe`]; `Unlocked(_)` → [`VaultCertTrustStore`], `Locked(_)` → a
+/// fresh [`MemoryCertTrustStore`]. Spawned by the binary next to the engine. The task
+/// holds the engine weakly and ends when the engine is dropped.
+pub fn spawn_cert_store_switch(
+    engine: VaultEngine,
+    switch: Arc<SwitchableCertTrustStore>,
+) -> tokio::task::JoinHandle<()> {
+    let mut rx = engine.subscribe();
+    let inner = Arc::downgrade(&engine.inner);
+    let unlocked = matches!(engine.state(), VaultState::Unlocked { .. });
+    drop(engine);
+    if unlocked {
+        point_at(&inner, true, &switch);
+    }
+    tokio::spawn(async move {
+        loop {
+            match rx.recv().await {
+                Ok(VaultChange::Unlocked(_)) => point_at(&inner, true, &switch),
+                Ok(VaultChange::Locked(_)) => point_at(&inner, false, &switch),
+                Ok(VaultChange::ItemsChanged { .. }) => {}
+                Err(RecvError::Lagged(_)) => {
+                    let unlocked = inner
+                        .upgrade()
+                        .map(VaultEngine::from_inner)
+                        .is_some_and(|e| matches!(e.state(), VaultState::Unlocked { .. }));
+                    point_at(&inner, unlocked, &switch);
+                }
+                Err(RecvError::Closed) => break,
+            }
+        }
+    })
+}
