+#[tokio::test]
+async fn explicit_handshake_failure_is_never_downgraded() {
+    let pki = Pki::new();
+    for mode in [
+        FtpEncryption::ExplicitIfAvailable,
+        FtpEncryption::RequireExplicit,
+    ] {
+        let ui = Ui::new(Ans::Trust(TrustAnswer::TrustOnce, 0));
+        // TLS 1.3-only server, TLS 1.2-only client: the handshake fails.
+        let cfg = pki.trusted(2, TlsVersions::Tls13Only);
+        let steps = vec![
+            Step::Reply("220 fake"),
+            Step::Expect("AUTH TLS"),
+            Step::Reply("234 Proceed"),
+            Step::StartTlsExpectFailure(cfg),
+        ];
+        let (server, addr) = FakeServer::tcp(steps).await;
+        let log = ui.log();
+        let mut session = pki.session(&memory_gate(), true);
+        let (mut ctrl, r) = connect_explicit(addr, &log, &mut session, mode).await;
+        assert!(matches!(r, Err(Error::Tls(_))), "{mode:?}: {r:?}");
+        assert_eq!(ctrl.state(), ControlState::Broken);
+        assert!(matches!(login(&mut ctrl).await, Err(Error::Connection(_))));
+        done(ctrl, server).await;
+        assert!(ui.prompts().is_empty());
+    }
