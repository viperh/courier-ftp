diff --git a/crates/courier-ftp-core/src/trust/certs.rs b/crates/courier-ftp-core/src/trust/certs.rs
new file mode 100644
index 0000000..01876ca
--- /dev/null
+++ b/crates/courier-ftp-core/src/trust/certs.rs
@@ -0,0 +1,207 @@
+//! Trusted TLS certificates (T12): entries, the store trait, the in-memory store and
+//! the switchable store the FTPS verifier holds.
+
+use std::{
+    fmt,
+    sync::{Arc, PoisonError, RwLock, RwLockReadGuard, RwLockWriteGuard},
+};
+
+use async_trait::async_trait;
+use time::OffsetDateTime;
+
+use super::normalize_host;
+use crate::{Result, events::PreviousCert};
+
+/// A certificate the user chose to "always trust" for host:port. Persisted by
+/// [`VaultCertTrustStore`](crate::vault::cert_trust::VaultCertTrustStore) as one
+/// `trusted-cert` item per host:port (T81 `TrustedCertItem`).
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct TrustedCert {
+    /// Lower-case DNS name or IP literal without brackets ([`normalize_host`]).
+    pub host: String,
+    /// Port.
+    pub port: u16,
+    /// SHA-256 of the end-entity certificate DER.
+    pub sha256: [u8; 32],
+    /// End-entity DER, at most 16 KiB (details view, T68).
+    pub der: Vec<u8>,
+    /// Subject, for display.
+    pub subject: String,
+    /// Issuer, for display.
+    pub issuer: String,
+    /// End of validity.
+    pub not_after: OffsetDateTime,
+    /// When the certificate was trusted.
+    pub added_at: OffsetDateTime,
+}
+
+impl TrustedCert {
+    /// The prompt's "previously trusted certificate" (changed-certificate warning).
+    pub fn to_previous(&self) -> PreviousCert {
+        PreviousCert {
+            sha256: self.sha256,
+            subject: self.subject.clone(),
+            not_after: self.not_after,
+            added_at: self.added_at,
+        }
+    }
+}
+
+/// Trusted-certificate storage. In memory until the vault is unlocked, then
+/// vault-backed (synced, D4).
+#[async_trait]
+pub trait CertTrustStore: Send + Sync + fmt::Debug {
+    /// Entries for `host:port` (`host` is normalised by the store).
+    ///
+    /// # Errors
+    /// The store could not be read (vault: `VaultLocked`, `Vault(..)`).
+    async fn lookup(&self, host: &str, port: u16) -> Result<Vec<TrustedCert>>;
+
+    /// Adds `cert` and removes every other entry for the same host:port ("always
+    /// trust" replaces the previous certificate).
+    ///
+    /// # Errors
+    /// The store could not be written.
+    async fn add(&self, cert: TrustedCert) -> Result<()>;
+
+    /// Every entry, sorted by (host, port) — for Settings (T68).
+    ///
+    /// # Errors
+    /// The store could not be read.
+    async fn list(&self) -> Result<Vec<TrustedCert>>;
+
+    /// Removes the entry for host:port with this fingerprint (no error when absent).
+    ///
+    /// # Errors
+    /// The store could not be written.
+    async fn remove(&self, host: &str, port: u16, sha256: &[u8; 32]) -> Result<()>;
+
+    /// false for the in-memory store (vault locked / not created): prompts then carry
+    /// `can_save = false` and "Always trust" is disabled.
+    fn is_persistent(&self) -> bool;
+}
+
+fn read<T>(l: &RwLock<T>) -> RwLockReadGuard<'_, T> {
+    l.read().unwrap_or_else(PoisonError::into_inner)
+}
+
+fn write<T>(l: &RwLock<T>) -> RwLockWriteGuard<'_, T> {
+    l.write().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// In-memory store (vault locked). [`Default`] → not persistent;
+/// [`persistent_for_tests`](Self::persistent_for_tests) claims persistence so tests can
+/// exercise "Always trust".
+#[derive(Debug, Default)]
+pub struct MemoryCertTrustStore {
+    entries: RwLock<Vec<TrustedCert>>,
+    persistent: bool,
+}
+
+impl MemoryCertTrustStore {
+    /// An empty, non-persistent store.
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// An empty store whose [`is_persistent`](CertTrustStore::is_persistent) is true
+    /// (tests of the "Always trust" path).
+    pub fn persistent_for_tests() -> Self {
+        Self {
+            entries: RwLock::default(),
+            persistent: true,
+        }
+    }
+}
+
+#[async_trait]
+impl CertTrustStore for MemoryCertTrustStore {
+    async fn lookup(&self, host: &str, port: u16) -> Result<Vec<TrustedCert>> {
+        let host = normalize_host(host);
+        Ok(read(&self.entries)
+            .iter()
+            .filter(|e| e.port == port && e.host == host)
+            .cloned()
+            .collect())
+    }
+
+    async fn add(&self, mut cert: TrustedCert) -> Result<()> {
+        cert.host = normalize_host(&cert.host);
+        let mut entries = write(&self.entries);
+        entries.retain(|e| !(e.host == cert.host && e.port == cert.port));
+        entries.push(cert);
+        Ok(())
+    }
+
+    async fn list(&self) -> Result<Vec<TrustedCert>> {
+        let mut all = read(&self.entries).clone();
+        all.sort_by(|a, b| (&a.host, a.port).cmp(&(&b.host, b.port)));
+        Ok(all)
+    }
+
+    async fn remove(&self, host: &str, port: u16, sha256: &[u8; 32]) -> Result<()> {
+        let host = normalize_host(host);
+        write(&self.entries).retain(|e| !(e.host == host && e.port == port && &e.sha256 == sha256));
+        Ok(())
+    }
+
+    fn is_persistent(&self) -> bool {
+        self.persistent
+    }
+}
+
+/// Delegates to the current store; swapped on vault unlock/lock
+/// ([`spawn_cert_store_switch`](crate::vault::cert_trust::spawn_cert_store_switch)).
+pub struct SwitchableCertTrustStore {
+    current: RwLock<Arc<dyn CertTrustStore>>,
+}
+
+impl fmt::Debug for SwitchableCertTrustStore {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("SwitchableCertTrustStore")
+            .field("current", &*read(&self.current))
+            .finish()
+    }
+}
+
+impl SwitchableCertTrustStore {
+    /// Starts with `initial`.
+    pub fn new(initial: Arc<dyn CertTrustStore>) -> Self {
+        Self {
+            current: RwLock::new(initial),
+        }
+    }
+
+    /// Replaces the store every later call goes to.
+    pub fn set(&self, store: Arc<dyn CertTrustStore>) {
+        *write(&self.current) = store;
+    }
+
+    /// The current store.
+    pub fn current(&self) -> Arc<dyn CertTrustStore> {
+        Arc::clone(&read(&self.current))
+    }
+}
+
+#[async_trait]
+impl CertTrustStore for SwitchableCertTrustStore {
+    async fn lookup(&self, host: &str, port: u16) -> Result<Vec<TrustedCert>> {
+        self.current().lookup(host, port).await
+    }
+
+    async fn add(&self, cert: TrustedCert) -> Result<()> {
+        self.current().add(cert).await
+    }
+
+    async fn list(&self) -> Result<Vec<TrustedCert>> {
+        self.current().list().await
+    }
+
+    async fn remove(&self, host: &str, port: u16, sha256: &[u8; 32]) -> Result<()> {
+        self.current().remove(host, port, sha256).await
+    }
+
+    fn is_persistent(&self) -> bool {
+        self.current().is_persistent()
+    }
+}
