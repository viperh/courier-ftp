+//! Unit tests of the FTPS pieces: the trust decision table, certificate details,
+//! problem mapping, the client config and the prompt payload snapshots (T69 renders
+//! them).
+
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use courier_ftp_core::trust::MemoryCertTrustStore;
+use proptest::prelude::*;
+use rcgen::{CertificateParams, KeyPair, PKCS_ECDSA_P256_SHA256};
+use rustls::{
+    CertificateError, OtherError,
+    pki_types::{CertificateDer, UnixTime},
+};
+
+use super::{
+    test_certs::{Ca, Leaf},
+    verifier::VerifyRecord,
+    *,
+};
+
+fn stored(fp: u8, added: i64) -> TrustedCert {
+    TrustedCert {
+        host: "fake.test".into(),
+        port: 21,
+        sha256: [fp; 32],
+        der: Vec::new(),
+        subject: format!("CN=old{fp}"),
+        issuer: "CN=old".into(),
+        not_after: OffsetDateTime::from_unix_timestamp(2_000_000_000).unwrap(),
+        added_at: OffsetDateTime::from_unix_timestamp(added).unwrap(),
+    }
+}
+
+#[test]
+fn decide_trust_table() {
+    let leaf = [7u8; 32];
+    let same = vec![stored(7, 10)];
+    let other = vec![stored(1, 10), stored(2, 20)];
+    let none: Vec<TrustedCert> = Vec::new();
+    for once in [false, true] {
+        for list in [&none, &same, &other] {
+            assert_eq!(
+                decide_trust(true, &leaf, list, once),
+                TrustOutcome::Accept(TrustSource::Platform),
+                "platform ok wins"
+            );
+        }
+        assert_eq!(
+            decide_trust(false, &leaf, &same, once),
+            TrustOutcome::Accept(TrustSource::Stored)
+        );
+    }
+    assert_eq!(
+        decide_trust(false, &leaf, &none, true),
+        TrustOutcome::Accept(TrustSource::Once)
+    );
+    assert_eq!(
+        decide_trust(false, &leaf, &none, false),
+        TrustOutcome::Prompt { previous: None }
+    );
+    assert_eq!(
+        decide_trust(false, &leaf, &other, true),
+        TrustOutcome::Accept(TrustSource::Once)
+    );
+    match decide_trust(false, &leaf, &other, false) {
+        TrustOutcome::Prompt {
+            previous: Some(prev),
+        } => {
+            assert_eq!(prev.sha256, [2; 32], "latest by added_at");
+            assert_eq!(prev.subject, "CN=old2");
+        }
+        other => panic!("{other:?}"),
+    }
+}
+
+#[test]
+fn cert_details_from_rcgen_self_signed() {
+    let der = Leaf::new(2).self_signed();
+    let d = certificate_details(&der);
+    assert_eq!(d.parse_error, None);
+    assert_eq!(d.subject, "CN=fake.test");
+    assert_eq!(d.issuer, "CN=fake.test");
+    assert_eq!(d.subject_cn.as_deref(), Some("fake.test"));
+    assert_eq!(d.serial, "02");
+    assert_eq!(d.not_before.year(), 2020);
+    assert_eq!(d.not_after.year(), 2099);
+    assert_eq!(d.sha256, sha256(&der));
+    assert_eq!(d.sha1, sha1(&der));
+    assert_eq!(d.sans, vec!["DNS:fake.test".to_owned()]);
+    assert_eq!(d.public_key, "Ed25519");
+    assert_eq!(d.signature_algorithm, "Ed25519");
+    assert!(d.self_signed);
+    assert!(!d.is_ca);
+
+    let ca = Ca::new();
+    let d = certificate_details(&ca.der);
+    assert!(d.is_ca && d.self_signed);
+    let d = certificate_details(&Leaf::new(3).signed_by(&ca));
+    assert!(!d.self_signed && !d.is_ca);
+    assert_eq!(d.issuer, "CN=courier-ftp test CA");
+}
+
+#[test]
+fn cert_details_lists_sans_and_key_size() {
+    let key = KeyPair::generate_for(&PKCS_ECDSA_P256_SHA256).unwrap();
+    let mut params =
+        CertificateParams::new(vec!["ftp.example.com".to_owned(), "192.0.2.7".to_owned()]).unwrap();
+    params
+        .subject_alt_names
+        .push(rcgen::SanType::IpAddress("2001:db8::1".parse().unwrap()));
+    let der = params.self_signed(&key).unwrap().der().clone();
+    let d = certificate_details(&der);
+    assert_eq!(d.parse_error, None);
+    assert_eq!(
+        d.sans,
+        vec![
+            "DNS:ftp.example.com".to_owned(),
+            "IP:192.0.2.7".to_owned(),
+            "IP:2001:db8::1".to_owned()
+        ]
+    );
+    assert_eq!(d.public_key, "EC P-256");
+    assert_eq!(d.signature_algorithm, "ecdsa-with-SHA256");
+}
+
+#[test]
+fn cert_details_parse_failure_keeps_fingerprints() {
+    let junk = b"definitely not a certificate".to_vec();
+    let d = certificate_details(&junk);
+    assert!(d.parse_error.is_some());
+    assert_eq!(d.sha256, sha256(&junk));
+    assert_eq!(d.sha1, sha1(&junk));
+    assert!(d.subject.is_empty() && d.sans.is_empty());
+    let big = vec![0x30; MAX_PARSE_DER + 1];
+    let d = certificate_details(&big);
+    assert!(d.parse_error.unwrap().contains("larger"));
+    assert_eq!(d.sha256, sha256(&big));
+}
+
+#[test]
+fn fingerprint_format() {
+    assert_eq!(fingerprint_hex(&[0xab, 0x01, 0xff]), "AB:01:FF");
+    assert_eq!(fingerprint_hex(&[]), "");
+    assert_eq!(
+        details::clean("a\u{1b}[31mb\u{9b}"),
+        "a\u{FFFD}[31mb\u{FFFD}"
+    );
+}
+
+#[test]
+fn cert_problem_mapping_from_rustls_errors() {
+    use CertificateError as C;
+    let e = |c: C| rustls::Error::InvalidCertificate(c);
+    let cases = [
+        (e(C::UnknownIssuer), false, CertProblem::UnknownIssuer),
+        (e(C::UnknownIssuer), true, CertProblem::SelfSigned),
+        (e(C::Expired), false, CertProblem::Expired),
+        (
+            e(C::ExpiredContext {
+                time: UnixTime::since_unix_epoch(Duration::from_secs(2)),
+                not_after: UnixTime::since_unix_epoch(Duration::from_secs(1)),
+            }),
+            false,
+            CertProblem::Expired,
+        ),
+        (e(C::NotValidYet), false, CertProblem::NotYetValid),
+        (e(C::NotValidForName), false, CertProblem::NotValidForName),
+        (
+            e(C::NotValidForNameContext {
+                expected: ServerName::try_from("a.test").unwrap(),
+                presented: vec![],
+            }),
+            false,
+            CertProblem::NotValidForName,
+        ),
+        (e(C::Revoked), false, CertProblem::Revoked),
+        (e(C::InvalidPurpose), false, CertProblem::InvalidPurpose),
+        (e(C::BadSignature), false, CertProblem::BadSignature),
+    ];
+    for (err, self_issued, want) in cases {
+        assert_eq!(cert_problem(&err, self_issued), want, "{err:?}");
+    }
+    assert!(matches!(
+        cert_problem(&e(C::BadEncoding), false),
+        CertProblem::Other(_)
+    ));
+    assert!(matches!(
+        cert_problem(
+            &e(C::Other(OtherError(std::sync::Arc::new(
+                std::io::Error::other("x")
+            )))),
+            false
+        ),
+        CertProblem::Other(_)
+    ));
+    assert_eq!(
+        cert_problem(&rustls::Error::General("boom".into()), false),
+        CertProblem::Other("unexpected error: boom".into())
+    );
+}
+
+fn gate() -> Arc<TlsTrustGate> {
+    TlsTrustGate::new(Arc::new(MemoryCertTrustStore::new()))
+}
+
+/// Whether the config's enabled versions (its `versions: [..]` Debug field) list `v`.
+fn has(c: &ClientConfig, v: &str) -> bool {
+    let all = format!("{c:?}");
+    let start = all.find("versions: [").expect("versions field");
+    let end = start + all[start..].find(']').expect("end of versions");
+    all[start..end].contains(v)
+}
+
+#[test]
+fn client_config_versions_and_resumption() {
+    let roots = || RootSource::Custom(Ca::new().roots());
+    let s = TlsSession::new("fake.test", 21, roots(), false, gate()).unwrap();
+    let c = s.client_config();
+    assert!(has(c, "TLSv1_3"));
+    assert!(has(c, "TLSv1_2"));
+    assert!(!has(c, "TLSv1_1"));
+    assert!(c.enable_sni && !c.enable_early_data);
+    let resumption = format!("{:?}", c.resumption);
+    assert!(resumption.contains("SessionIdOrTickets"), "{resumption}");
+    assert!(!s.is_tls12_only());
+
+    let s = TlsSession::new("fake.test", 21, roots(), true, gate()).unwrap();
+    assert!(!has(s.client_config(), "TLSv1_3"));
+    assert!(has(s.client_config(), "TLSv1_2"));
+
+    // The gate's learned hint removes TLS 1.3 for that host:port only.
+    let g = gate();
+    assert!(g.mark_tls12_only("FAKE.test", 21));
+    assert!(!g.mark_tls12_only("fake.test", 21));
+    let s = TlsSession::new("fake.test", 21, roots(), false, Arc::clone(&g)).unwrap();
+    assert!(s.is_tls12_only());
+    assert!(!has(s.client_config(), "TLSv1_3"));
+    let s = TlsSession::new("fake.test", 990, roots(), false, g).unwrap();
+    assert!(!s.is_tls12_only());
+
+    // IP literals are valid server names (no SNI is sent for them).
+    assert!(TlsSession::new("[::1]", 21, roots(), false, gate()).is_ok());
+    assert!(TlsSession::new("192.0.2.1", 21, roots(), false, gate()).is_ok());
+    assert!(matches!(
+        TlsSession::new("bad name!", 21, roots(), false, gate()),
+        Err(Error::Tls(_))
+    ));
+    // The platform verifier can be built (the OS store loads lazily).
+    assert!(TlsSession::new("fake.test", 21, RootSource::Platform, false, gate()).is_ok());
+}
+
+#[test]
+fn check_data_error_classifies_reuse_failures() {
+    let mut s = TlsSession::new(
+        "fake.test",
+        21,
+        RootSource::Custom(Ca::new().roots()),
+        false,
+        gate(),
+    )
+    .unwrap();
+    let reuse = || Error::Protocol {
+        code: Some(522),
+        message: "SSL connection failed: session reuse required".into(),
+    };
+    // Unrelated errors pass through.
+    let other = Error::Protocol {
+        code: Some(550),
+        message: "No such file".into(),
+    };
+    assert!(matches!(
+        s.check_data_error(other),
+        Ok(Error::Protocol {
+            code: Some(550),
+            ..
+        })
+    ));
+    // TLS 1.2 control session: nothing to fall back to.
+    s.info = Some(info("TLSv1.2"));
+    assert!(matches!(s.check_data_error(reuse()), Ok(Error::Tls(m)) if m == REUSE_FAILED));
+    // TLS 1.3: reconnect once with TLS 1.2, then report the failure.
+    s.info = Some(info("TLSv1.3"));
+    assert_eq!(s.check_data_error(reuse()).unwrap_err(), TlsReuseRequired);
+    assert!(s.gate().is_tls12_only("fake.test", 21));
+    assert!(matches!(s.check_data_error(reuse()), Ok(Error::Tls(m)) if m == REUSE_FAILED));
+    let resum = Error::Protocol {
+        code: Some(425),
+        message: "Unable to build data connection: TLS session resumption required".into(),
+    };
+    assert!(matches!(s.check_data_error(resum), Ok(Error::Tls(_))));
+}
+
+fn info(protocol: &str) -> TlsSessionInfo {
+    TlsSessionInfo {
+        protocol: protocol.into(),
+        cipher_suite: "TLS13_AES_256_GCM_SHA384".into(),
+        server_name: "fake.test".into(),
+        chain: Vec::new(),
+        trusted_by: TrustSource::Once,
+        data_protection: DataProtection::Clear,
+    }
+}
+
+#[test]
+fn data_hook_maps_reuse_replies() {
+    let s = TlsSession::new(
+        "fake.test",
+        21,
+        RootSource::Custom(Ca::new().roots()),
+        false,
+        gate(),
+    )
+    .unwrap();
+    let hook = s.data_hook();
+    let handshake = || Error::Tls("handshake failed".into());
+    let reply = |code: u16, text: &str| {
+        Reply::new(
+            crate::reply::ReplyCode::new(code).unwrap(),
+            vec![format!("{code} {text}")],
+        )
+    };
+    assert!(matches!(
+        hook.map_failure(
+            handshake(),
+            Some(&reply(522, "SSL connection failed: session reuse required"))
+        ),
+        Error::Protocol {
+            code: Some(522),
+            ..
+        }
+    ));
+    assert!(matches!(
+        hook.map_failure(
+            handshake(),
+            Some(&reply(426, "Failure writing network stream."))
+        ),
+        Error::Tls(_)
+    ));
+    assert!(matches!(hook.map_failure(handshake(), None), Error::Tls(_)));
+}
+
+// ---- prompt payload snapshots (T69 renders them) ----------------------------------------
+
+/// 2026-06-01, inside every leaf's validity except the expired one.
+fn snapshot_now() -> OffsetDateTime {
+    OffsetDateTime::from_unix_timestamp(1_780_272_000).unwrap()
+}
+
+fn prompt_for(chain: Vec<CertificateDer<'static>>, ca: &Ca, previous: bool) -> CertPromptDetails {
+    let verifier = WebPkiServerVerifier::builder_with_provider(
+        Arc::new(ca.roots()),
+        Arc::new(rustls::crypto::ring::default_provider()),
+    )
+    .build()
+    .unwrap();
+    let name = ServerName::try_from("fake.test").unwrap();
+    let now = UnixTime::since_unix_epoch(Duration::from_secs(
+        snapshot_now().unix_timestamp().unsigned_abs(),
+    ));
+    let platform = verifier
+        .verify_server_cert(&chain[0], &chain[1..], &name, &[], now)
+        .map(drop);
+    let record = VerifyRecord {
+        chain_der: chain,
+        platform,
+    };
+    let session = TlsSessionInfo {
+        protocol: "TLSv1.3".into(),
+        cipher_suite: "TLS13_AES_256_GCM_SHA384".into(),
+        server_name: "fake.test".into(),
+        chain: record
+            .chain_der
+            .iter()
+            .map(|c| certificate_details(c))
+            .collect(),
+        trusted_by: TrustSource::Once,
+        data_protection: DataProtection::Clear,
+    };
+    let mut details = prompt_details(&name, "fake.test", 21, &record, session, snapshot_now());
+    if previous {
+        details.previous = Some(stored(0x5a, 1_700_000_000).to_previous());
+        details.can_save = true;
+    }
+    details
+}
+
+#[test]
+fn snapshot_prompt_self_signed() {
+    let ca = Ca::new();
+    let d = prompt_for(vec![Leaf::new(2).self_signed()], &ca, false);
+    assert_eq!(d.problems, vec![CertProblem::SelfSigned]);
+    assert!(d.hostname_matches);
+    insta::assert_debug_snapshot!("cert_prompt_self_signed", d);
+}
+
+#[test]
+fn snapshot_prompt_expired() {
+    let ca = Ca::new();
+    let leaf = Leaf {
+        years: (2019, 2021),
+        ..Leaf::new(3)
+    };
+    let d = prompt_for(vec![leaf.signed_by(&ca), ca.der.clone()], &ca, false);
+    assert_eq!(d.problems, vec![CertProblem::Expired]);
+    insta::assert_debug_snapshot!("cert_prompt_expired", d);
+}
+
+#[test]
+fn snapshot_prompt_wrong_host() {
+    let ca = Ca::new();
+    let leaf = Leaf {
+        names: vec!["wrong.example"],
+        ..Leaf::new(4)
+    };
+    let d = prompt_for(vec![leaf.signed_by(&ca)], &ca, false);
+    assert_eq!(d.problems, vec![CertProblem::NotValidForName]);
+    assert!(!d.hostname_matches);
+    insta::assert_debug_snapshot!("cert_prompt_wrong_host", d);
+}
+
+#[test]
+fn snapshot_prompt_changed_certificate() {
+    let ca = Ca::new();
+    let d = prompt_for(vec![Leaf::new(5).self_signed()], &ca, true);
+    assert!(d.previous.is_some());
+    insta::assert_debug_snapshot!("cert_prompt_changed", d);
+}
+
+proptest! {
+    #![proptest_config(ProptestConfig::with_cases(256))]
+
+    #[test]
+    fn prop_cert_details_never_panics_on_random_der(
+        bytes in proptest::collection::vec(any::<u8>(), 0..4096),
+    ) {
+        let d = certificate_details(&bytes);
+        prop_assert_eq!(d.sha256, sha256(&bytes));
+        // Random bytes almost never form a certificate; when they fail, it is reported.
+        if d.subject.is_empty() && d.serial.is_empty() {
+            prop_assert!(d.parse_error.is_some());
+        }
+    }
+
+    #[test]
+    fn prop_cert_details_never_panics_on_mutated_der(
+        flips in proptest::collection::vec((any::<prop::sample::Index>(), any::<u8>()), 1..8),
+    ) {
+        let mut der = Leaf::new(2).self_signed().to_vec();
+        for (i, b) in flips {
+            let at = i.index(der.len());
+            der[at] ^= b;
+        }
+        let d = certificate_details(&der);
+        prop_assert_eq!(d.sha256, sha256(&der));
+    }
+}
diff --git a/crates/courier-ftp-proto-ftp/src/tls/verifier.rs b/crates/courier-ftp-proto-ftp/src/tls/verifier.rs
new file mode 100644
index 0000000..310bbd3
--- /dev/null
+++ b/crates/courier-ftp-proto-ftp/src/tls/verifier.rs
@@ -0,0 +1,211 @@
+//! The rustls verifier of an FTPS session (T12 §4) and the pure trust decision.
+//!
+//! rustls verifiers are synchronous, so the control handshake uses a **deferred
+//! verdict**: [`FtpCertVerifier`] runs the base verifier (the OS store or a fixed root
+//! set), records the chain and the result and lets the handshake finish; the session
+//! then decides ([`decide_trust`], possibly prompting) before a single byte is written
+//! on the stream. Signature checks (proof of key possession) always go to the base
+//! verifier. After acceptance the verifier pins the leaf: a data connection doing a
+//! full handshake must present the same certificate.
+
+use std::{
+    fmt,
+    sync::{Arc, Mutex, MutexGuard, PoisonError},
+};
+
+use courier_ftp_core::{
+    events::{PreviousCert, TrustSource},
+    trust::TrustedCert,
+};
+use rustls::{
+    DigitallySignedStruct, DistinguishedName, SignatureScheme,
+    client::danger::{HandshakeSignatureValid, ServerCertVerified, ServerCertVerifier},
+    pki_types::{CertificateDer, ServerName, UnixTime},
+};
+
+use super::details::sha256;
+
+/// Error text when a data connection presents another certificate.
+pub const DATA_CERT_DIFFERS: &str = "data connection certificate differs from control connection";
+
+/// What the control handshake's verification found.
+#[derive(Debug, Clone)]
+pub(crate) struct VerifyRecord {
+    /// Leaf first.
+    pub chain_der: Vec<CertificateDer<'static>>,
+    /// The base verifier's verdict.
+    pub platform: Result<(), rustls::Error>,
+}
+
+#[derive(Debug)]
+pub(crate) enum VerifierState {
+    /// Control handshake: record, do not decide.
+    Control { record: Option<VerifyRecord> },
+    /// Data handshakes: the leaf must be this one.
+    Data { leaf_sha256: [u8; 32] },
+}
+
+/// The session's verifier (shared by the control and data handshakes through the
+/// session's `ClientConfig`).
+pub(crate) struct FtpCertVerifier {
+    inner: Arc<dyn ServerCertVerifier>,
+    state: Mutex<VerifierState>,
+    mismatch: Mutex<bool>,
+}
+
+impl fmt::Debug for FtpCertVerifier {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("FtpCertVerifier")
+            .field("state", &*lock(&self.state))
+            .finish_non_exhaustive()
+    }
+}
+
+fn lock<T>(m: &Mutex<T>) -> MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+impl FtpCertVerifier {
+    pub(crate) fn new(inner: Arc<dyn ServerCertVerifier>) -> Self {
+        Self {
+            inner,
+            state: Mutex::new(VerifierState::Control { record: None }),
+            mismatch: Mutex::new(false),
+        }
+    }
+
+    /// Back to recording (before a control handshake).
+    pub(crate) fn reset_control(&self) {
+        *lock(&self.state) = VerifierState::Control { record: None };
+    }
+
+    /// The record of the last control handshake (`None` for a resumed one).
+    pub(crate) fn take_record(&self) -> Option<VerifyRecord> {
+        match &mut *lock(&self.state) {
+            VerifierState::Control { record } => record.take(),
+            VerifierState::Data { .. } => None,
+        }
+    }
+
+    /// Pins the accepted leaf for the data connections.
+    pub(crate) fn pin(&self, leaf_sha256: [u8; 32]) {
+        *lock(&self.state) = VerifierState::Data { leaf_sha256 };
+    }
+
+    /// True once after a data handshake was refused for a different leaf.
+    pub(crate) fn take_mismatch(&self) -> bool {
+        std::mem::take(&mut *lock(&self.mismatch))
+    }
+}
+
+impl ServerCertVerifier for FtpCertVerifier {
+    fn verify_server_cert(
+        &self,
+        end_entity: &CertificateDer<'_>,
+        intermediates: &[CertificateDer<'_>],
+        server_name: &ServerName<'_>,
+        ocsp_response: &[u8],
+        now: UnixTime,
+    ) -> Result<ServerCertVerified, rustls::Error> {
+        let mut state = lock(&self.state);
+        match &mut *state {
+            VerifierState::Control { record } => {
+                let platform = self
+                    .inner
+                    .verify_server_cert(end_entity, intermediates, server_name, ocsp_response, now)
+                    .map(drop);
+                let mut chain_der = Vec::with_capacity(intermediates.len() + 1);
+                chain_der.push(end_entity.clone().into_owned());
+                chain_der.extend(intermediates.iter().map(|c| c.clone().into_owned()));
+                *record = Some(VerifyRecord {
+                    chain_der,
+                    platform,
+                });
+                // Deferred: the session decides before anything is written.
+                Ok(ServerCertVerified::assertion())
+            }
+            VerifierState::Data { leaf_sha256 } => {
+                if sha256(end_entity) == *leaf_sha256 {
+                    Ok(ServerCertVerified::assertion())
+                } else {
+                    *lock(&self.mismatch) = true;
+                    Err(rustls::Error::General(DATA_CERT_DIFFERS.into()))
+                }
+            }
+        }
+    }
+
+    fn verify_tls12_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        self.inner.verify_tls12_signature(message, cert, dss)
+    }
+
+    fn verify_tls13_signature(
+        &self,
+        message: &[u8],
+        cert: &CertificateDer<'_>,
+        dss: &DigitallySignedStruct,
+    ) -> Result<HandshakeSignatureValid, rustls::Error> {
+        self.inner.verify_tls13_signature(message, cert, dss)
+    }
+
+    fn supported_verify_schemes(&self) -> Vec<SignatureScheme> {
+        self.inner.supported_verify_schemes()
+    }
+
+    fn root_hint_subjects(&self) -> Option<&[DistinguishedName]> {
+        self.inner.root_hint_subjects()
+    }
+}
+
+/// The trust decision for a control handshake.
+#[derive(Debug, Clone, PartialEq)]
+pub enum TrustOutcome {
+    /// Accept without asking.
+    Accept(TrustSource),
+    /// Ask the user; `previous` is set when another certificate is stored for the
+    /// host:port (changed-certificate warning).
+    Prompt {
+        /// The latest stored certificate (by `added_at`).
+        previous: Option<PreviousCert>,
+    },
+}
+
+/// The pure decision table (T12 §4):
+///
+/// | Platform | Stored for host:port | In "once" set | Decision |
+/// |---|---|---|---|
+/// | Ok | any | – | accept, `Platform` |
+/// | Err | contains the leaf | – | accept, `Stored` |
+/// | Err | none | yes | accept, `Once` |
+/// | Err | none | no | prompt (new certificate) |
+/// | Err | other certificate(s) | no | prompt with `previous` (changed) |
+///
+/// The "once" set wins over other stored certificates too: the user already accepted
+/// this exact certificate in this process.
+pub fn decide_trust(
+    platform_ok: bool,
+    leaf_sha256: &[u8; 32],
+    stored: &[TrustedCert],
+    once: bool,
+) -> TrustOutcome {
+    if platform_ok {
+        return TrustOutcome::Accept(TrustSource::Platform);
+    }
+    if stored.iter().any(|c| &c.sha256 == leaf_sha256) {
+        return TrustOutcome::Accept(TrustSource::Stored);
+    }
+    if once {
+        return TrustOutcome::Accept(TrustSource::Once);
+    }
+    TrustOutcome::Prompt {
+        previous: stored
+            .iter()
+            .max_by_key(|c| c.added_at)
+            .map(TrustedCert::to_previous),
+    }
+}
