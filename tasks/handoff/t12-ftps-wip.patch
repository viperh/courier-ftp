+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "needs Docker (COURIER_E2E=1)"]
+async fn ftps_self_signed_prompt_then_always_trust() {
+    require_docker!();
+    let ftpd = start_with_cert(CertVariant::SelfSigned).await;
+    let home = TestHome::with_vault().await.unwrap();
+    let store: Arc<dyn CertTrustStore> =
+        Arc::new(VaultCertTrustStore::new(home.vault().await.unwrap()));
+
+    let ui = Ui::new(TrustAnswer::AlwaysTrust);
+    let gate = TlsTrustGate::new(Arc::clone(&store));
+    let (conn, session) = connect(&ftpd, &gate, &ui).await.unwrap();
+    assert_eq!(session.info().unwrap().trusted_by, TrustSource::Stored);
+    conn.quit().await;
+    let prompts = ui.prompts();
+    assert_eq!(prompts.len(), 1);
+    assert!(prompts[0].can_save);
+    let der = ftpd.cert_der().await.unwrap();
+    let stored = store.lookup(&ftpd.host(), 21).await.unwrap();
+    assert_eq!(stored.len(), 1);
+    assert_eq!(stored[0].sha256, sha256(&der));
+
+    // Next connection (a new process: fresh gate, same vault): silent.
+    let ui = Ui::new(TrustAnswer::Reject);
+    let gate = TlsTrustGate::new(store);
+    let (mut conn, session) = connect(&ftpd, &gate, &ui).await.unwrap();
+    assert_eq!(session.info().unwrap().trusted_by, TrustSource::Stored);
+    transfers(&ftpd, &mut conn, &session, "t12-self-signed.bin")
+        .await
+        .unwrap();
+    conn.quit().await;
+    assert!(ui.prompts().is_empty());
+}
