+/// A persistent store whose writes fail (vault locked between swap and call).
+#[derive(Debug, Default)]
+struct LockedStore {
+    adds: AtomicUsize,
+}
+
+#[async_trait]
+impl CertTrustStore for LockedStore {
+    async fn lookup(&self, _: &str, _: u16) -> Result<Vec<TrustedCert>> {
+        Ok(Vec::new())
+    }
+    async fn add(&self, _: TrustedCert) -> Result<()> {
+        self.adds.fetch_add(1, Ordering::SeqCst);
+        Err(Error::VaultLocked)
+    }
+    async fn list(&self) -> Result<Vec<TrustedCert>> {
+        Ok(Vec::new())
+    }
+    async fn remove(&self, _: &str, _: u16, _: &[u8; 32]) -> Result<()> {
+        Ok(())
+    }
+    fn is_persistent(&self) -> bool {
+        true
+    }
+}
