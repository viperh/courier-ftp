+// ---- AC4 / AC5: data connections resume the control session -------------------------------
+
+async fn resumed_download(versions: TlsVersions, want_version: &str) {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let cfg = pki.trusted(2, versions);
+    let steps = script(vec![
+        explicit(&cfg),
+        login_steps(),
+        prot_p(),
+        serve_tls(&cfg, DataTlsCheck::RequireResumed, "RETR a.bin", 300_000),
+        // A second transfer resumes too (new TLS 1.3 tickets arrive per connection).
+        vec![
+            Step::EpsvListen,
+            Step::Expect("RETR b.bin"),
+            Step::Reply("150 Opening BINARY mode data connection."),
+            Step::SendPattern {
+                offset: 0,
+                len: 1000,
+            },
+            Step::CloseData,
+            Step::Reply("226 Transfer complete."),
+        ],
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), false);
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    assert_eq!(session.info().unwrap().protocol, want_version);
+    let hook = session.data_hook();
+    let got = download(&mut ctrl, &hook, "a.bin").await.unwrap();
+    assert_eq!(got, pattern_bytes(0, 300_000));
+    let got = download(&mut ctrl, &hook, "b.bin").await.unwrap();
+    assert_eq!(got, pattern_bytes(0, 1000));
+    let t = done(ctrl, server).await;
+    assert_eq!(
+        t.data_tls,
+        vec![
+            (want_version.to_owned(), true),
+            (want_version.to_owned(), true)
+        ]
+    );
+    let debug = ui.debug_lines().await;
+    assert!(
+        debug.iter().any(|l| l.contains("resumed handshake")),
+        "{debug:?}"
+    );
+}
