+// ---- harness ------------------------------------------------------------------------------
+
+/// How the fake UI answers certificate prompts.
+#[derive(Clone, Copy, Debug)]
+enum Ans {
+    Trust(TrustAnswer, u64),
+    Cancel,
+}
+
+/// Plays the UI: records logs and certificate prompts, answers after a delay (ms).
+struct Ui {
+    events: courier_ftp_core::events::EventSender,
+    prompts: Arc<Mutex<Vec<CertPromptDetails>>>,
+    logs: Arc<Mutex<Vec<LogMessage>>>,
+    _task: tokio::task::JoinHandle<()>,
+}
+
+impl Ui {
+    fn new(answer: Ans) -> Self {
+        let (events, mut rx) = channel(DebugLevel::Debug);
+        let prompts = Arc::new(Mutex::new(Vec::new()));
+        let logs = Arc::new(Mutex::new(Vec::new()));
+        let (p, l) = (Arc::clone(&prompts), Arc::clone(&logs));
+        let task = tokio::spawn(async move {
+            while let Some(event) = rx.recv().await {
+                match event {
+                    CoreEvent::Log(m) => l.lock().unwrap().push(m),
+                    CoreEvent::Prompt(req) => {
+                        if let PromptKind::TrustCertificate(d) = &req.kind {
+                            p.lock().unwrap().push((**d).clone());
+                        }
+                        tokio::spawn(async move {
+                            match answer {
+                                Ans::Trust(a, delay) => {
+                                    tokio::time::sleep(Duration::from_millis(delay)).await;
+                                    req.respond(PromptResponse::Certificate(a));
+                                }
+                                Ans::Cancel => {
+                                    req.respond(PromptResponse::Cancel);
+                                }
+                            }
+                        });
+                    }
+                    _ => {}
+                }
+            }
+        });
+        Self {
+            events,
+            prompts,
+            logs,
+            _task: task,
+        }
+    }
+
+    fn log(&self) -> SessionLog {
+        SessionLog {
+            events: self.events.clone(),
+            session: SessionId::next(),
+        }
+    }
+
+    fn prompts(&self) -> Vec<CertPromptDetails> {
+        self.prompts.lock().unwrap().clone()
+    }
+
+    async fn debug_lines(&self) -> Vec<String> {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+        self.logs
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|m| matches!(m.kind, LogKind::Debug(_)))
+            .map(|m| m.text.clone())
+            .collect()
+    }
+
+    async fn lines(&self, kind: LogKind) -> Vec<String> {
+        tokio::time::sleep(Duration::from_millis(20)).await;
+        self.logs
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|m| m.kind == kind)
+            .map(|m| m.text.clone())
+            .collect()
+    }
+}
+
+fn token() -> CancellationToken {
+    CancellationToken::new()
+}
+
+fn net_opts(purpose: Purpose) -> NetOpts {
+    NetOpts {
+        timeout: Duration::from_secs(5),
+        prefer_ipv6: false,
+        allow_ipv6: true,
+        purpose,
+        socket_buffer: None,
+        proxy: ProxyConfig::Direct,
+    }
+}
+
+fn params(addr: std::net::SocketAddr, log: &SessionLog) -> ControlParams {
+    ControlParams {
+        target: HostPort::new(addr.ip().to_string(), addr.port()),
+        server_name: "fake.test".into(),
+        net: net_opts(Purpose::Control),
+        charset: Charset::Auto,
+        timeout: Duration::from_secs(5),
+        keepalive_command: KeepaliveCommand::Noop,
+        log: log.clone(),
+    }
+}
+
+fn data_cfg() -> DataConfig {
+    DataConfig {
+        mode: DataMode::Passive,
+        fallback_to_active: false,
+        ignore_unroutable_pasv_ip: true,
+        external_ip: ActiveExternalIp::Auto,
+        no_external_ip_on_local: true,
+        port_range: None,
+        through_generic_proxy: false,
+        net: net_opts(Purpose::Data),
+        control_host: "127.0.0.1".into(),
+        timeout: Duration::from_secs(5),
+        socket_buffer: DEFAULT_SOCKET_BUFFER,
+    }
+}
+
+fn memory_gate() -> Arc<TlsTrustGate> {
+    TlsTrustGate::new(Arc::new(MemoryCertTrustStore::new()))
+}
+
+fn persistent_gate() -> (Arc<TlsTrustGate>, Arc<MemoryCertTrustStore>) {
+    let store = Arc::new(MemoryCertTrustStore::persistent_for_tests());
+    (TlsTrustGate::new(store.clone()), store)
+}
+
+/// The CA, and server configs over its leaves (seed 2) or self-signed leaves.
+struct Pki {
+    ca: Ca,
+}
+
+impl Pki {
+    fn new() -> Self {
+        Self { ca: Ca::new() }
+    }
+
+    fn session(&self, gate: &Arc<TlsTrustGate>, max_tls12: bool) -> TlsSession {
+        TlsSession::new(
+            "fake.test",
+            21,
+            RootSource::Custom(self.ca.roots()),
+            max_tls12,
+            Arc::clone(gate),
+        )
+        .unwrap()
+    }
+
+    /// CA-signed leaf `seed` (platform-trusted), chain leaf + CA.
+    fn trusted(&self, seed: u8, versions: TlsVersions) -> Arc<ServerConfig> {
+        let chain = vec![Leaf::new(seed).signed_by(&self.ca), self.ca.der.clone()];
+        tls_server_config(chain, private_key(seed), versions)
+    }
+
+    /// Self-signed leaf `seed` (needs the user's trust).
+    fn self_signed(seed: u8, versions: TlsVersions) -> Arc<ServerConfig> {
+        tls_server_config(
+            vec![Leaf::new(seed).self_signed()],
+            private_key(seed),
+            versions,
+        )
+    }
+}
+
+fn explicit(cfg: &Arc<ServerConfig>) -> Vec<Step> {
+    vec![
+        Step::Reply("220 fake ready"),
+        Step::Expect("AUTH TLS"),
+        Step::Reply("234 Proceed with negotiation."),
+        Step::StartTls(Arc::clone(cfg)),
+    ]
+}
+
+fn login_steps() -> Vec<Step> {
+    vec![
+        Step::Expect("USER user"),
+        Step::Reply("331 Please specify the password."),
+        Step::ExpectSecret {
+            verb: "PASS",
+            value: "pw",
+        },
+        Step::Reply("230 Login successful."),
+    ]
+}
+
+fn prot_p() -> Vec<Step> {
+    vec![
+        Step::Expect("PBSZ 0"),
+        Step::Reply("200 PBSZ=0"),
+        Step::Expect("PROT P"),
+        Step::Reply("200 PROT now Private."),
+    ]
+}
+
+fn script(parts: Vec<Vec<Step>>) -> Vec<Step> {
+    parts.into_iter().flatten().collect()
+}
+
+async fn login(ctrl: &mut ControlConnection) -> Result<()> {
+    let info = LoginPromptInfo {
+        target: "user@fake.test:21".into(),
+        cache_key: SecretCacheKey::Password {
+            protocol: Protocol::Ftp,
+            host: "fake.test".into(),
+            port: 21,
+            user: "user".into(),
+        },
+        can_save: false,
+    };
+    let logon = LogonType::Normal {
+        password: Some(SecretString::from("pw")),
+    };
+    let s = LoginScript::for_logon(Some("user"), &logon, info).unwrap();
+    ctrl.login(s, &token()).await
+}
+
+/// TCP connect + greeting (explicit and plain modes).
+async fn connect(addr: std::net::SocketAddr, log: &SessionLog) -> ControlConnection {
+    let (ctrl, _) = ControlConnection::connect(params(addr, log), None, &token())
+        .await
+        .expect("connect");
+    ctrl
+}
+
+/// Explicit FTPS up to the trust decision.
+async fn connect_explicit(
+    addr: std::net::SocketAddr,
+    log: &SessionLog,
+    session: &mut TlsSession,
+    mode: FtpEncryption,
+) -> (ControlConnection, Result<bool>) {
+    let mut ctrl = connect(addr, log).await;
+    let r = start_tls(&mut ctrl, session, mode, &token()).await;
+    (ctrl, r)
+}
+
+/// Explicit FTPS + login + PBSZ/PROT P.
+async fn full_session(
+    addr: std::net::SocketAddr,
+    log: &SessionLog,
+    session: &mut TlsSession,
+) -> ControlConnection {
+    let (mut ctrl, r) = connect_explicit(addr, log, session, FtpEncryption::RequireExplicit).await;
+    assert!(r.expect("start_tls"));
+    login(&mut ctrl).await.expect("login");
+    let p = protect_data(&mut ctrl, session, FtpEncryption::RequireExplicit, &token())
+        .await
+        .expect("protect_data");
+    assert_eq!(p, DataProtection::Private);
+    ctrl
+}
+
+fn retr(path: &str) -> TransferCommand {
+    TransferCommand::Retr {
+        path: path.into(),
+        offset: 0,
+        range_len: None,
+    }
+}
+
+async fn download(ctrl: &mut ControlConnection, hook: &TlsDataHook, path: &str) -> Result<Vec<u8>> {
+    let cfg = data_cfg();
+    let mut state = DataState::default();
+    let mut d = FtpData {
+        ctrl,
+        cfg: &cfg,
+        state: &mut state,
+    };
+    let mut s = d
+        .open(retr(path), TransferType::Binary, Some(hook), &token())
+        .await?;
+    let mut out = Vec::new();
+    s.read_to_end(&mut out).await?;
+    d.finish(Some(s), &token()).await?;
+    Ok(out)
+}
+
+async fn upload(
+    ctrl: &mut ControlConnection,
+    hook: &TlsDataHook,
+    path: &str,
+    bytes: &[u8],
+) -> Result<()> {
+    let cfg = data_cfg();
+    let mut state = DataState::default();
+    let mut d = FtpData {
+        ctrl,
+        cfg: &cfg,
+        state: &mut state,
+    };
+    let cmd = TransferCommand::Stor {
+        path: path.into(),
+        offset: 0,
+    };
+    let mut s = d
+        .open(cmd, TransferType::Binary, Some(hook), &token())
+        .await?;
+    s.write_all(bytes).await?;
+    d.finish(Some(s), &token()).await
+}
+
+/// `TYPE I`, `EPSV`, `RETR`, `150`, the bytes, close (with close_notify), `226`.
+fn serve_tls(
+    cfg: &Arc<ServerConfig>,
+    check: DataTlsCheck,
+    path: &'static str,
+    len: u64,
+) -> Vec<Step> {
+    vec![
+        Step::DataTls(Some((Arc::clone(cfg), check))),
+        Step::Expect("TYPE I"),
+        Step::Reply("200 Switching to Binary mode."),
+        Step::EpsvListen,
+        Step::Expect(path),
+        Step::Reply("150 Opening BINARY mode data connection."),
+        Step::SendPattern { offset: 0, len },
+        Step::CloseData,
+        Step::Reply("226 Transfer complete."),
+    ]
+}
+
+async fn done(ctrl: ControlConnection, server: FakeServer) -> Transcript {
+    drop(ctrl);
+    server.finish().await
+}
