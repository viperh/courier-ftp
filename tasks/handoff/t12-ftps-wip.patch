+//! FTPS against the scripted [`FakeServer`] with `tokio-rustls` acceptors and rcgen
+//! certificates (`RootSource::Custom`), over loopback TCP in real time.
+
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicUsize, Ordering},
+};
+
+use courier_ftp_core::{
+    events::{CoreEvent, LogKind, LogMessage, SecretCacheKey, SessionId, channel},
+    model::{Charset, LogonType, Protocol, TransferType},
+    net::{HostPort, NetOpts, ProxyConfig, Purpose},
+    secret::SecretString,
+    settings::{ActiveExternalIp, DebugLevel, KeepaliveCommand},
+    trust::MemoryCertTrustStore,
+};
