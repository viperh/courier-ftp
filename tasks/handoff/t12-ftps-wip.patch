+//! T12 end to end: FTPS (`courier_ftp_proto_ftp::tls`) against the TLS profiles of the
+//! ftpd fixture — vsftpd explicit, implicit and "session reuse required", pure-ftpd and
+//! proftpd mod_tls — with the TEST-ONLY CA as `RootSource::Custom`: login, `PROT P`,
+//! `LIST`, upload + download with SHA-256 checks; plus the "trust this certificate"
+//! flow against a self-signed and a changed certificate, stored in a `TestHome` vault.
+//! Every test is `#[ignore]` and starts with `require_docker!()`; run with
+//! `COURIER_E2E=1 cargo test -p courier-ftp-e2e --test ftps -- --ignored`.
+
+#![allow(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::{
+    sync::{Arc, Mutex},
+    time::Duration,
+};
+
+use courier_ftp_core::{
+    Error,
