diff --git a/crates/courier-ftp-proto-ftp/src/tls/test_certs.rs b/crates/courier-ftp-proto-ftp/src/tls/test_certs.rs
new file mode 100644
index 0000000..8133400
--- /dev/null
+++ b/crates/courier-ftp-proto-ftp/src/tls/test_certs.rs
@@ -0,0 +1,123 @@
+//! Deterministic test certificates (rcgen, Ed25519 keys from fixed seeds, fixed
+//! dates and serials): the same DER on every run, so fingerprints can be snapshotted.
+
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use rcgen::{
+    BasicConstraints, CertificateParams, DnType, IsCa, Issuer, KeyPair, PKCS_ED25519, SerialNumber,
+    date_time_ymd,
+};
+use rustls::{
+    RootCertStore,
+    pki_types::{CertificateDer, PrivateKeyDer, PrivatePkcs8KeyDer},
+};
+
+/// PKCS#8 v1 prefix of an Ed25519 private key; the 32-byte seed follows.
+const ED25519_PKCS8_PREFIX: [u8; 16] = [
+    0x30, 0x2e, 0x02, 0x01, 0x00, 0x30, 0x05, 0x06, 0x03, 0x2b, 0x65, 0x70, 0x04, 0x22, 0x04, 0x20,
+];
+
+fn pkcs8(seed: u8) -> Vec<u8> {
+    let mut der = ED25519_PKCS8_PREFIX.to_vec();
+    der.extend([seed; 32]);
+    der
+}
+
+/// An Ed25519 key pair from a fixed seed.
+pub(super) fn key(seed: u8) -> KeyPair {
+    KeyPair::from_pkcs8_der_and_sign_algo(&PrivatePkcs8KeyDer::from(pkcs8(seed)), &PKCS_ED25519)
+        .expect("ed25519 key")
+}
+
+/// The private key in rustls form.
+pub(super) fn private_key(seed: u8) -> PrivateKeyDer<'static> {
+    PrivateKeyDer::Pkcs8(PrivatePkcs8KeyDer::from(pkcs8(seed)))
+}
+
+/// A test CA (key seed 1).
+pub(super) struct Ca {
+    params: CertificateParams,
+    key: KeyPair,
+    /// Its certificate.
+    pub(super) der: CertificateDer<'static>,
+}
+
+impl Ca {
+    /// "courier-ftp test CA", 2020–2099.
+    pub(super) fn new() -> Self {
+        let key = key(1);
+        let mut params = CertificateParams::new(Vec::<String>::new()).unwrap();
+        params
+            .distinguished_name
+            .push(DnType::CommonName, "courier-ftp test CA");
+        params.is_ca = IsCa::Ca(BasicConstraints::Unconstrained);
+        params.not_before = date_time_ymd(2020, 1, 1);
+        params.not_after = date_time_ymd(2099, 1, 1);
+        params.serial_number = Some(SerialNumber::from(vec![1]));
+        let der = params.self_signed(&key).unwrap().der().clone();
+        Self { params, key, der }
+    }
+
+    /// A root store holding only this CA.
+    pub(super) fn roots(&self) -> RootCertStore {
+        let mut roots = RootCertStore::empty();
+        roots.add(self.der.clone()).unwrap();
+        roots
+    }
+}
+
+/// How to build a leaf certificate.
+pub(super) struct Leaf {
+    /// SAN DNS names.
+    pub(super) names: Vec<&'static str>,
+    /// Key seed.
+    pub(super) seed: u8,
+    /// Serial number byte.
+    pub(super) serial: u8,
+    /// Validity years (from Jan 1st to Jan 1st).
+    pub(super) years: (i32, i32),
+}
+
+impl Leaf {
+    /// `fake.test`, valid 2020–2099.
+    pub(super) fn new(seed: u8) -> Self {
+        Self {
+            names: vec!["fake.test"],
+            seed,
+            serial: seed,
+            years: (2020, 2099),
+        }
+    }
+
+    fn params(&self) -> CertificateParams {
+        let names: Vec<String> = self.names.iter().map(|n| (*n).to_owned()).collect();
+        let mut params = CertificateParams::new(names).unwrap();
+        params.distinguished_name.push(
+            DnType::CommonName,
+            self.names.first().copied().unwrap_or("leaf"),
+        );
+        params.not_before = date_time_ymd(self.years.0, 1, 1);
+        params.not_after = date_time_ymd(self.years.1, 1, 1);
+        params.serial_number = Some(SerialNumber::from(vec![self.serial]));
+        params
+    }
+
+    /// Self-signed.
+    pub(super) fn self_signed(&self) -> CertificateDer<'static> {
+        self.params()
+            .self_signed(&key(self.seed))
+            .unwrap()
+            .der()
+            .clone()
+    }
+
+    /// Signed by `ca`.
+    pub(super) fn signed_by(&self, ca: &Ca) -> CertificateDer<'static> {
+        let issuer = Issuer::from_params(&ca.params, &ca.key);
+        self.params()
+            .signed_by(&key(self.seed), &issuer)
+            .unwrap()
+            .der()
+            .clone()
+    }
+}
