+/// Serves `chain` but signs the handshake with another key.
+#[derive(Debug)]
+struct ForgedKey(Arc<CertifiedKey>);
+
+impl ResolvesServerCert for ForgedKey {
+    fn resolve(&self, _: ClientHello<'_>) -> Option<Arc<CertifiedKey>> {
+        Some(Arc::clone(&self.0))
+    }
+}
+
+fn forged_server(
+    chain: Vec<CertificateDer<'static>>,
+    key: PrivateKeyDer<'static>,
+    versions: TlsVersions,
+) -> Arc<ServerConfig> {
+    let provider = Arc::new(rustls::crypto::ring::default_provider());
+    let signer = provider.key_provider.load_private_key(key).unwrap();
+    let v: &[&rustls::SupportedProtocolVersion] = match versions {
+        TlsVersions::Tls12Only => &[&rustls::version::TLS12],
+        _ => &[&rustls::version::TLS13],
+    };
+    let config = ServerConfig::builder_with_provider(provider)
+        .with_protocol_versions(v)
+        .unwrap()
+        .with_no_client_auth()
+        .with_cert_resolver(Arc::new(ForgedKey(Arc::new(CertifiedKey::new(
+            chain, signer,
+        )))));
+    Arc::new(config)
+}
+
+#[tokio::test]
+async fn verifier_delegates_signature_checks() {
+    let pki = Pki::new();
+    for versions in [TlsVersions::Tls12Only, TlsVersions::Tls13Only] {
+        let ui = Ui::new(Ans::Trust(TrustAnswer::TrustOnce, 0));
+        // A valid, CA-signed certificate, but the server does not hold its key.
+        let chain = vec![Leaf::new(2).signed_by(&pki.ca), pki.ca.der.clone()];
+        let cfg = forged_server(chain, private_key(9), versions);
+        let steps = vec![
+            Step::Reply("220 fake"),
+            Step::Expect("AUTH TLS"),
+            Step::Reply("234 Proceed"),
+            Step::StartTlsExpectFailure(cfg),
+        ];
+        let (server, addr) = FakeServer::tcp(steps).await;
+        let log = ui.log();
+        let mut session = pki.session(&memory_gate(), false);
+        let (ctrl, r) =
+            connect_explicit(addr, &log, &mut session, FtpEncryption::RequireExplicit).await;
+        assert!(matches!(r, Err(Error::Tls(_))), "{versions:?}: {r:?}");
+        done(ctrl, server).await;
+        assert!(ui.prompts().is_empty(), "the signature is never deferred");
+    }
+}
+
+// ---- AC10: data certificate pinning -------------------------------------------------------
+
+#[tokio::test]
+async fn data_cert_mismatch_refused() {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let control = pki.trusted(2, TlsVersions::Both);
+    // Also CA-signed (platform-valid), but another certificate.
+    let other = pki.trusted(3, TlsVersions::Both);
+    let steps = script(vec![
+        explicit(&control),
+        login_steps(),
+        prot_p(),
+        vec![
+            Step::DataTls(Some((other, DataTlsCheck::ExpectFailure))),
+            Step::Expect("TYPE I"),
+            Step::Reply("200 Switching to Binary mode."),
+            Step::EpsvListen,
+            Step::Expect("RETR f.bin"),
+            Step::Reply("150 Opening BINARY mode data connection."),
+            Step::DataHandshake,
+            Step::Reply("425 Cannot secure data connection."),
+        ],
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), false);
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    let err = download(&mut ctrl, &session.data_hook(), "f.bin")
+        .await
+        .unwrap_err();
+    assert!(
+        matches!(&err, Error::Tls(m) if m == DATA_CERT_DIFFERS),
+        "{err:?}"
+    );
+    assert_eq!(ctrl.state(), ControlState::Ready);
+    let t = done(ctrl, server).await;
+    assert_eq!(t.data_tls, vec![("failed".to_owned(), false)]);
+}
+
+// ---- AC11: close_notify -------------------------------------------------------------------
+
+#[tokio::test]
+async fn upload_sends_close_notify() {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let cfg = pki.trusted(2, TlsVersions::Both);
+    let bytes = pattern_bytes(0, 200_000);
+    let steps = script(vec![
+        explicit(&cfg),
+        login_steps(),
+        prot_p(),
+        vec![
+            Step::DataTls(Some((Arc::clone(&cfg), DataTlsCheck::RequireResumed))),
+            Step::Expect("TYPE I"),
+            Step::Reply("200 Switching to Binary mode."),
+            Step::EpsvListen,
+            Step::Expect("STOR up.bin"),
+            Step::Reply("150 Ok to send data."),
+            // Reading to EOF over TLS fails unless the client sent close_notify.
+            Step::RecvData(bytes.clone()),
+            Step::Reply("226 Transfer complete."),
+        ],
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), false);
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    upload(&mut ctrl, &session.data_hook(), "up.bin", &bytes)
+        .await
+        .unwrap();
+    done(ctrl, server).await;
+}
+
+async fn download_without_notify(final_reply: &'static str) -> Result<Vec<u8>> {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let cfg = pki.trusted(2, TlsVersions::Both);
+    let steps = script(vec![
+        explicit(&cfg),
+        login_steps(),
+        prot_p(),
+        vec![
+            Step::DataTls(Some((Arc::clone(&cfg), DataTlsCheck::Any))),
+            Step::Expect("TYPE I"),
+            Step::Reply("200 Switching to Binary mode."),
+            Step::EpsvListen,
+            Step::Expect("RETR f.bin"),
+            Step::Reply("150 Opening BINARY mode data connection."),
+            Step::SendPattern {
+                offset: 0,
+                len: 70_000,
+            },
+            Step::CloseDataNoNotify,
+            Step::Reply(final_reply),
+        ],
+    ]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), false);
+    let mut ctrl = full_session(addr, &log, &mut session).await;
+    let r = download(&mut ctrl, &session.data_hook(), "f.bin").await;
+    done(ctrl, server).await;
+    r
+}
+
+#[tokio::test]
+async fn download_without_close_notify_ok_with_226() {
+    let got = download_without_notify("226 Transfer complete.")
+        .await
+        .unwrap();
+    assert_eq!(got, pattern_bytes(0, 70_000));
+}
+
+#[tokio::test]
+async fn download_without_close_notify_fails_without_226() {
+    let r = download_without_notify("426 Failure writing network stream.").await;
+    assert!(
+        matches!(
+            r,
+            Err(Error::Protocol {
+                code: Some(426),
+                ..
+            })
+        ),
+        "{r:?}"
+    );
+    let r = download_without_notify("200 Whatever.").await;
+    assert!(matches!(r, Err(Error::Connection(_))), "{r:?}");
+}
+
+// ---- AC12: session info -------------------------------------------------------------------
+
+#[tokio::test]
+async fn session_info_reports_version_and_cipher() {
+    let ui = Ui::new(Ans::Cancel);
+    let pki = Pki::new();
+    let cfg = pki.trusted(2, TlsVersions::Tls13Only);
+    let steps = script(vec![explicit(&cfg), login_steps(), prot_p()]);
+    let (server, addr) = FakeServer::tcp(steps).await;
+    let log = ui.log();
+    let mut session = pki.session(&memory_gate(), false);
+    let ctrl = full_session(addr, &log, &mut session).await;
+    done(ctrl, server).await;
+    let info = session.info().unwrap();
+    assert_eq!(info.protocol, "TLSv1.3");
+    assert!(
+        info.cipher_suite.starts_with("TLS13_"),
+        "{}",
+        info.cipher_suite
+    );
+    assert_eq!(info.server_name, "fake.test");
+    assert_eq!(info.trusted_by, TrustSource::Platform);
+    assert_eq!(info.data_protection, DataProtection::Private);
+    assert_eq!(info.chain.len(), 2);
+    assert_eq!(info.chain[0].subject_cn.as_deref(), Some("fake.test"));
+    assert!(info.chain[1].is_ca);
+    let debug = ui.debug_lines().await;
+    assert!(
+        debug.iter().any(|l| l.starts_with("TLSv1.3, TLS13_")),
+        "{debug:?}"
+    );
+}
