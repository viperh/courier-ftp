+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+#[ignore = "needs Docker (COURIER_E2E=1)"]
+async fn ftps_changed_certificate_warns() {
+    require_docker!();
+    let ftpd = start_with_cert(CertVariant::SelfSigned).await;
+    let home = TestHome::with_vault().await.unwrap();
+    let old = ftpd.cert_der().await.unwrap();
+    home.trust_cert(&ftpd.host(), 21, &old).await.unwrap();
+    let store: Arc<dyn CertTrustStore> =
+        Arc::new(VaultCertTrustStore::new(home.vault().await.unwrap()));
+
+    // Trusted: silent.
+    let ui = Ui::new(TrustAnswer::Reject);
+    let gate = TlsTrustGate::new(Arc::clone(&store));
+    let (conn, _) = connect(&ftpd, &gate, &ui).await.unwrap();
+    conn.quit().await;
+    assert!(ui.prompts().is_empty());
+
+    // The server now presents another certificate (same container, same IP).
+    ftpd.set_cert(CertVariant::WrongHost).await.unwrap();
+    let new = ftpd.cert_der().await.unwrap();
+    let ui = Ui::new(TrustAnswer::Reject);
+    let gate = TlsTrustGate::new(Arc::clone(&store));
+    let err = connect(&ftpd, &gate, &ui).await.err().expect("rejected");
+    assert!(matches!(err, Error::Tls(_)), "{err:?}");
+    let prompts = ui.prompts();
+    assert_eq!(prompts.len(), 1);
+    let previous = prompts[0]
+        .previous
+        .as_ref()
+        .expect("changed-certificate warning");
+    assert_eq!(previous.sha256, sha256(&old));
+    assert_eq!(prompts[0].session.chain[0].sha256, sha256(&new));
+    assert!(!prompts[0].hostname_matches);
+    // Rejected: the stored entry is unchanged.
+    let stored = store.lookup(&ftpd.host(), 21).await.unwrap();
+    assert_eq!(stored.len(), 1);
+    assert_eq!(stored[0].sha256, sha256(&old));
+}
