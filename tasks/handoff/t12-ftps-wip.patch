@@ -0,0 +1,934 @@
+//! FTPS (T12): explicit (`AUTH TLS`, RFC 4217) and implicit TLS on rustls with the
+//! `ring` provider (D9), certificate verification against the OS trust store, the
+//! FileZilla-style "trust this certificate" flow, `PBSZ`/`PROT`, and TLS on every data
+//! connection with session resumption.
+//!
+//! ```text
+//! TlsSession::new(host, port, roots, max_tls12, gate)   # one per control connection
+//! implicit:  ControlConnection::connect(p, Some(&session.implicit(..)), ..)
+//! explicit:  connect → start_tls(ctrl, session, mode)   # AUTH TLS / AUTH SSL → 234
+//! login (T10) → protect_data(ctrl, session, mode)       # PBSZ 0, PROT P
+//! FtpData::open(cmd, ty, Some(&session.data_hook()), ..) # resumed data handshakes
+//! ```
+//!
+//! **Trust.** The control handshake records the base verifier's verdict and finishes;
+//! [`TlsSession::secure_control`] then decides with [`decide_trust`] — the platform,
+//! the [`CertTrustStore`] ("always trust", vault-backed once unlocked) or the
+//! process-wide "trust once" set of the [`TlsTrustGate`] — and otherwise asks the user
+//! (`PromptKind::TrustCertificate`). Concurrent connections that hit the same
+//! certificate share one prompt. Nothing is written on the stream before the decision;
+//! a rejected certificate closes the connection without `close_notify`.
+//!
+//! **Data connections** use the session's `ClientConfig` (and so its resumption
+//! cache) and the control connection's server name; a full data handshake must present
+//! the control connection's leaf certificate. A server that insists on resumption and
+//! refuses ours under TLS 1.3 is remembered per host:port ([`TlsReuseRequired`]): T14
+//! reconnects with TLS 1.2 only.
+
+mod details;
+mod verifier;
+
+use std::{
+    collections::{HashMap, HashSet},
+    fmt,
+    sync::{Arc, Mutex, MutexGuard, PoisonError, RwLock},
+    time::Duration,
+};
+
+use async_trait::async_trait;
+use courier_ftp_core::{
+    Error, Result,
+    events::{
+        CertProblem, CertPromptDetails, CertificateDetails, DataProtection, PromptKind,
+        PromptResponse, SessionLog, TlsSessionInfo, TrustAnswer, TrustSource,
+    },
+    model::FtpEncryption,
+    net::CancellationToken,
+    trust::{CertTrustStore, TrustedCert, normalize_host},
+};
+use futures::{
+    FutureExt as _,
+    future::{BoxFuture, Shared},
+};
+use rustls::{
+    ClientConfig, ProtocolVersion, RootCertStore,
+    client::{
+        Resumption, Tls12Resumption, WebPkiServerVerifier, danger::ServerCertVerifier,
+        verify_server_name,
+    },
+    pki_types::ServerName,
+    server::ParsedCertificate,
+};
+use time::OffsetDateTime;
+use tokio_rustls::TlsConnector;
+
+pub use details::{
+    MAX_PARSE_DER, cert_problem, certificate_details, fingerprint_hex, sha1, sha256,
+};
+pub use verifier::{DATA_CERT_DIFFERS, TrustOutcome, decide_trust};
+use verifier::{FtpCertVerifier, VerifyRecord};
+
+use crate::{
+    command::Command,
+    control::{BoxedIo, ControlConnection, StreamUpgrade},
+    data::{DataIo, DataTlsHook, RawData},
+    reply::Reply,
+};
+
+/// Status line when `ExplicitIfAvailable` continues without TLS.
+pub const NO_TLS_WARNING: &str = "Warning: Server does not support FTP over TLS. The connection, including your password, is not encrypted.";
+/// Status line when `ExplicitIfAvailable` falls back to `PROT C`.
+pub const PROT_C_WARNING: &str = "Warning: Data connections will not be encrypted";
+/// Status line before a reconnect with TLS 1.2 (T14).
+pub const REUSE_RECONNECT_STATUS: &str =
+    "Server requires TLS session resumption; reconnecting with TLS 1.2";
+/// `Error::Tls` when TLS is required and `AUTH` is refused.
+pub const NO_TLS_SUPPORT: &str = "server does not support FTP over TLS";
+/// `Error::Tls` when `PROT P` is refused and encryption is required.
+pub const PROT_REFUSED: &str = "server refused to encrypt data connections (PROT P)";
+/// `Error::Tls` when the user (or the store) rejects the certificate.
+pub const CERT_REJECTED: &str = "certificate rejected";
+/// `Error::Tls` when resumption is required and TLS 1.2 did not help either.
+pub const REUSE_FAILED: &str = "server requires TLS session resumption, which failed";
+/// Default handshake timeout (T14 passes `connection.timeout_secs`).
+pub const DEFAULT_HANDSHAKE_TIMEOUT: Duration = Duration::from_secs(20);
+/// Size of the per-session resumption cache.
+const RESUMPTION_CACHE: usize = 64;
+/// `AUTH TLS` replies after which `AUTH SSL` is tried.
+const AUTH_REFUSED: [u16; 5] = [500, 502, 504, 431, 534];
+
+fn lock<T>(m: &Mutex<T>) -> MutexGuard<'_, T> {
+    m.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+/// The data connections need the server's "session reuse required" signal: T14
+/// reconnects with a TLS 1.2-only config and retries the operation once (T12 §5).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct TlsReuseRequired;
+
+impl fmt::Display for TlsReuseRequired {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str(REUSE_RECONNECT_STATUS)
+    }
+}
+
+impl std::error::Error for TlsReuseRequired {}
+
+// ---- the process-wide gate ----------------------------------------------------------------
+
+type CertKey = (String, u16, [u8; 32]);
+
+/// The shared prompt's outcome.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+enum Answer {
+    Accepted(TrustSource),
+    Rejected,
+    Cancelled,
+}
+
+type PendingPrompt = Shared<BoxFuture<'static, Answer>>;
+
+/// Process-wide trust state shared by all FTP backend instances (created by the
+/// `BackendFactory`, T14): the store, the "trust once" set, prompt de-duplication and
+/// the learned "reuse needs TLS 1.2" hosts.
+pub struct TlsTrustGate {
+    store: RwLock<Arc<dyn CertTrustStore>>,
+    once: Mutex<HashSet<CertKey>>,
+    pending: Mutex<HashMap<CertKey, PendingPrompt>>,
+    tls12_only_hosts: Mutex<HashSet<(String, u16)>>,
+}
+
+impl fmt::Debug for TlsTrustGate {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TlsTrustGate")
+            .field("store", &self.store())
+            .field("once", &lock(&self.once).len())
+            .field("pending", &lock(&self.pending).len())
+            .finish_non_exhaustive()
+    }
+}
+
+impl TlsTrustGate {
+    /// A gate over `store` (normally a `SwitchableCertTrustStore`).
+    pub fn new(store: Arc<dyn CertTrustStore>) -> Arc<Self> {
+        Arc::new(Self {
+            store: RwLock::new(store),
+            once: Mutex::default(),
+            pending: Mutex::default(),
+            tls12_only_hosts: Mutex::default(),
+        })
+    }
+
+    /// Replaces the store.
+    pub fn set_store(&self, store: Arc<dyn CertTrustStore>) {
+        *self.store.write().unwrap_or_else(PoisonError::into_inner) = store;
+    }
+
+    /// The current store.
+    pub fn store(&self) -> Arc<dyn CertTrustStore> {
+        Arc::clone(&self.store.read().unwrap_or_else(PoisonError::into_inner))
+    }
+
+    fn key(host: &str, port: u16, sha256: &[u8; 32]) -> CertKey {
+        (normalize_host(host), port, *sha256)
+    }
+
+    /// Whether this certificate was accepted for host:port in this process.
+    pub fn is_trusted_once(&self, host: &str, port: u16, sha256: &[u8; 32]) -> bool {
+        lock(&self.once).contains(&Self::key(host, port, sha256))
+    }
+
+    /// Forgets every "trust once" decision (Settings, T68).
+    pub fn clear_once(&self) {
+        lock(&self.once).clear();
+    }
+
+    /// Whether host:port needs TLS 1.2 for session reuse (learned, process lifetime).
+    pub fn is_tls12_only(&self, host: &str, port: u16) -> bool {
+        lock(&self.tls12_only_hosts).contains(&(normalize_host(host), port))
+    }
+
+    /// Remembers that host:port needs TLS 1.2. Returns false when it was known.
+    pub fn mark_tls12_only(&self, host: &str, port: u16) -> bool {
+        lock(&self.tls12_only_hosts).insert((normalize_host(host), port))
+    }
+
+    /// Decides (§4), prompting at most once per (host, port, certificate) at a time.
+    async fn decide(
+        self: &Arc<Self>,
+        req: TrustRequest,
+        cancel: &CancellationToken,
+    ) -> Result<TrustSource> {
+        let store = self.store();
+        let stored = match store.lookup(&req.cert.host, req.cert.port).await {
+            Ok(v) => v,
+            Err(e) => {
+                req.log
+                    .debug(3, format!("Could not read the trusted certificates: {e}"));
+                Vec::new()
+            }
+        };
+        let once = self.is_trusted_once(&req.cert.host, req.cert.port, &req.cert.sha256);
+        match decide_trust(req.platform_ok, &req.cert.sha256, &stored, once) {
+            TrustOutcome::Accept(source) => Ok(source),
+            TrustOutcome::Prompt { previous } => {
+                let mut details = req.details;
+                details.previous = previous;
+                details.can_save = store.is_persistent();
+                self.ask(req.cert, details, req.log, cancel).await
+            }
+        }
+    }
+
+    async fn ask(
+        self: &Arc<Self>,
+        cert: TrustedCert,
+        details: CertPromptDetails,
+        log: SessionLog,
+        cancel: &CancellationToken,
+    ) -> Result<TrustSource> {
+        let key = Self::key(&cert.host, cert.port, &cert.sha256);
+        // Declared before the future so that it drops after it.
+        let _guard = PendingGuard {
+            gate: self,
+            key: &key,
+        };
+        let prompt = {
+            let mut pending = lock(&self.pending);
+            if let Some(p) = pending.get(&key) {
+                p.clone()
+            } else {
+                // Another connection may have decided just before us.
+                if lock(&self.once).contains(&key) {
+                    return Ok(TrustSource::Once);
+                }
+                let gate = Arc::clone(self);
+                let p = async move { gate.prompt_and_record(cert, details, log).await }
+                    .boxed()
+                    .shared();
+                pending.insert(key.clone(), p.clone());
+                p
+            }
+        };
+        let answer = tokio::select! {
+            biased;
+            () = cancel.cancelled() => Answer::Cancelled,
+            a = prompt => a,
+        };
+        match answer {
+            Answer::Accepted(source) => Ok(source),
+            Answer::Rejected => Err(Error::Tls(CERT_REJECTED.into())),
+            Answer::Cancelled => Err(Error::Cancelled),
+        }
+    }
+
+    /// The shared prompt: asks and records the answer (once set / store).
+    async fn prompt_and_record(
+        self: Arc<Self>,
+        cert: TrustedCert,
+        details: CertPromptDetails,
+        log: SessionLog,
+    ) -> Answer {
+        let key = Self::key(&cert.host, cert.port, &cert.sha256);
+        let kind = PromptKind::TrustCertificate(Box::new(details));
+        let response = log.events.prompt(log.session, kind).await;
+        let answer = match response {
+            Ok(PromptResponse::Certificate(a)) => a,
+            Ok(_) => TrustAnswer::Reject,
+            Err(Error::Cancelled) => return Answer::Cancelled,
+            Err(e) => {
+                log.debug(3, format!("Certificate prompt failed: {e}"));
+                return Answer::Rejected;
+            }
+        };
+        match answer {
+            TrustAnswer::Reject => Answer::Rejected,
+            TrustAnswer::TrustOnce => {
+                lock(&self.once).insert(key);
+                Answer::Accepted(TrustSource::Once)
+            }
+            TrustAnswer::AlwaysTrust => {
+                let source = match self.store().add(cert).await {
+                    Ok(()) => TrustSource::Stored,
+                    Err(e) => {
+                        log.error(format!("Could not save trusted certificate: {e}"));
+                        TrustSource::Once
+                    }
+                };
+                // Also remembered for the process: parallel connections that decided
+                // before the store write landed do not ask again.
+                lock(&self.once).insert(key);
+                Answer::Accepted(source)
+            }
+        }
+    }
+}
+
+/// Removes the shared prompt when its last waiter is gone (the prompt is then
+/// withdrawn) or when it completed.
+struct PendingGuard<'a> {
+    gate: &'a TlsTrustGate,
+    key: &'a CertKey,
+}
+
+impl Drop for PendingGuard<'_> {
+    fn drop(&mut self) {
+        let mut pending = lock(&self.gate.pending);
+        if let Some(p) = pending.get(self.key)
+            && p.strong_count().is_none_or(|n| n <= 1)
+        {
+            pending.remove(self.key);
+        }
+    }
+}
+
+struct TrustRequest {
+    cert: TrustedCert,
+    platform_ok: bool,
+    details: CertPromptDetails,
+    log: SessionLog,
+}
+
+// ---- the session ----------------------------------------------------------------------------
+
+/// Base chain verifier: the OS store in production, a fixed root set in tests.
+#[derive(Debug, Clone)]
+pub enum RootSource {
+    /// `rustls-platform-verifier` (OS trust store, OS revocation checks).
+    Platform,
+    /// A `WebPkiServerVerifier` over these roots.
+    Custom(RootCertStore),
+}
+
+impl RootSource {
+    /// `Custom` roots from DER certificates (the e2e test CA, T76).
+    ///
+    /// # Errors
+    ///
+    /// `Tls` when a certificate is not a usable trust anchor.
+    pub fn custom_from_der(certs: impl IntoIterator<Item = Vec<u8>>) -> Result<Self> {
+        let mut roots = RootCertStore::empty();
+        for der in certs {
+            roots
+                .add(rustls::pki_types::CertificateDer::from(der))
+                .map_err(tls_err)?;
+        }
+        Ok(Self::Custom(roots))
+    }
+}
+
+/// One FTPS session: the `rustls::ClientConfig` (with its resumption cache) shared by
+/// the control connection and all of its data connections.
+pub struct TlsSession {
+    config: Arc<ClientConfig>,
+    verifier: Arc<FtpCertVerifier>,
+    server_name: ServerName<'static>,
+    host: String,
+    port: u16,
+    tls12_only: bool,
+    gate: Arc<TlsTrustGate>,
+    info: Option<TlsSessionInfo>,
+    timeout: Duration,
+    log: Option<SessionLog>,
+}
+
+impl fmt::Debug for TlsSession {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TlsSession")
+            .field("server_name", &self.server_name)
+            .field("port", &self.port)
+            .field("tls12_only", &self.tls12_only)
+            .field("info", &self.info)
+            .finish_non_exhaustive()
+    }
+}
+
+fn tls_err(e: impl fmt::Display) -> Error {
+    Error::Tls(e.to_string())
+}
+
+fn version_name(v: Option<ProtocolVersion>) -> String {
+    match v {
+        Some(ProtocolVersion::TLSv1_3) => "TLSv1.3".into(),
+        Some(ProtocolVersion::TLSv1_2) => "TLSv1.2".into(),
+        Some(other) => format!("{other:?}"),
+        None => "unknown".into(),
+    }
+}
+
+/// `"reuse"`/`"resum"` in a reply text (vsftpd `522 SSL connection failed: session
+/// reuse required`).
+fn is_reuse_text(text: &str) -> bool {
+    let t = text.to_ascii_lowercase();
+    t.contains("reuse") || t.contains("resum")
+}
+
+impl TlsSession {
+    /// A session for `server_name` (the TLS peer: the site host, or the FTP proxy
+    /// host, T15) and `port`. TLS 1.3 + 1.2, or TLS 1.2 only with `max_tls12` or when
+    /// the gate learned that the host needs it.
+    ///
+    /// # Errors
+    ///
+    /// `Tls` (invalid server name, no platform verifier, empty custom roots).
+    pub fn new(
+        server_name: &str,
+        port: u16,
+        roots: RootSource,
+        max_tls12: bool,
+        gate: Arc<TlsTrustGate>,
+    ) -> Result<Self> {
+        let provider = Arc::new(rustls::crypto::ring::default_provider());
+        let inner: Arc<dyn ServerCertVerifier> = match roots {
+            RootSource::Platform => Arc::new(
+                rustls_platform_verifier::Verifier::new(Arc::clone(&provider)).map_err(tls_err)?,
+            ),
+            RootSource::Custom(roots) => {
+                WebPkiServerVerifier::builder_with_provider(Arc::new(roots), Arc::clone(&provider))
+                    .build()
+                    .map_err(tls_err)?
+            }
+        };
+        let host = normalize_host(server_name);
+        let tls12_only = max_tls12 || gate.is_tls12_only(&host, port);
+        let versions: &[&rustls::SupportedProtocolVersion] = if tls12_only {
+            &[&rustls::version::TLS12]
+        } else {
+            &[&rustls::version::TLS13, &rustls::version::TLS12]
+        };
+        let verifier = Arc::new(FtpCertVerifier::new(inner));
+        let mut config = ClientConfig::builder_with_provider(provider)
+            .with_protocol_versions(versions)
+            .map_err(tls_err)?
+            .dangerous()
+            .with_custom_certificate_verifier(Arc::clone(&verifier) as Arc<dyn ServerCertVerifier>)
+            .with_no_client_auth();
+        config.resumption = Resumption::in_memory_sessions(RESUMPTION_CACHE)
+            .tls12_resumption(Tls12Resumption::SessionIdOrTickets);
+        config.enable_sni = true;
+        config.enable_early_data = false;
+        let server_name = ServerName::try_from(host.clone())
+            .map_err(|e| Error::Tls(format!("invalid TLS server name: {e}")))?;
+        Ok(Self {
+            config: Arc::new(config),
+            verifier,
+            server_name,
+            host,
+            port,
+            tls12_only,
+            gate,
+            info: None,
+            timeout: DEFAULT_HANDSHAKE_TIMEOUT,
+            log: None,
+        })
+    }
+
+    /// Sets the handshake timeout (`connection.timeout_secs`).
+    pub fn set_handshake_timeout(&mut self, timeout: Duration) {
+        self.timeout = timeout;
+    }
+
+    /// Whether this session offers TLS 1.2 only.
+    pub fn is_tls12_only(&self) -> bool {
+        self.tls12_only
+    }
+
+    /// The gate this session decides with.
+    pub fn gate(&self) -> &Arc<TlsTrustGate> {
+        &self.gate
+    }
+
+    /// The negotiated session (after [`secure_control`](Self::secure_control)).
+    pub fn info(&self) -> Option<&TlsSessionInfo> {
+        self.info.as_ref()
+    }
+
+    /// The `rustls` client config (tests, T41b).
+    #[doc(hidden)]
+    pub fn client_config(&self) -> &Arc<ClientConfig> {
+        &self.config
+    }
+
+    /// Handshake on the control stream, then the trust decision (may prompt). Nothing
+    /// is written on the returned stream before the decision.
+    ///
+    /// # Errors
+    ///
+    /// `Tls` (handshake failure, certificate rejected), `Timeout`, `Cancelled`.
+    pub async fn secure_control(
+        &mut self,
+        io: BoxedIo,
+        log: &SessionLog,
+        cancel: &CancellationToken,
+    ) -> Result<BoxedIo> {
+        log.status("Initializing TLS...");
+        self.log = Some(log.clone());
+        self.verifier.reset_control();
+        let connector = TlsConnector::from(Arc::clone(&self.config));
+        let handshake = tokio::time::timeout(
+            self.timeout,
+            connector.connect(self.server_name.clone(), io),
+        );
+        let stream = tokio::select! {
+            biased;
+            () = cancel.cancelled() => return Err(Error::Cancelled),
+            r = handshake => match r {
+                Err(_) => {
+                    log.error("TLS handshake timed out");
+                    return Err(Error::Timeout);
+                }
+                Ok(Err(e)) => {
+                    log.error(format!("TLS handshake failed: {e}"));
+                    tracing::info!(session = log.session.get(), "tls handshake failed");
+                    return Err(tls_err(e));
+                }
+                Ok(Ok(s)) => s,
+            },
+        };
+        let (protocol, cipher) = {
+            let (_, conn) = stream.get_ref();
+            (
+                version_name(conn.protocol_version()),
+                conn.negotiated_cipher_suite()
+                    .map_or_else(|| "unknown".to_owned(), |s| format!("{:?}", s.suite())),
+            )
+        };
+        let Some(record) = self.verifier.take_record() else {
+            // A resumed control handshake (reconnect on the same session): the
+            // certificate was decided before.
+            let Some(info) = self.info.as_mut() else {
+                return Err(Error::Tls(
+                    "resumed TLS session without a certificate".into(),
+                ));
+            };
+            info.protocol = protocol;
+            info.cipher_suite = cipher;
+            log.status("TLS connection established.");
+            return Ok(Box::new(stream));
+        };
+        let Some(leaf_der) = record.chain_der.first() else {
+            return Err(Error::Tls("the server sent no certificate".into()));
+        };
+        let leaf_sha256 = sha256(leaf_der);
+        let mut session = TlsSessionInfo {
+            protocol,
+            cipher_suite: cipher,
+            server_name: self.host.clone(),
+            chain: record
+                .chain_der
+                .iter()
+                .map(|c| certificate_details(c))
+                .collect(),
+            trusted_by: TrustSource::Once,
+            data_protection: DataProtection::Clear,
+        };
+        let details = prompt_details(
+            &self.server_name,
+            &self.host,
+            self.port,
+            &record,
+            session.clone(),
+            OffsetDateTime::now_utc(),
+        );
+        let leaf = &session.chain[0];
+        let cert = TrustedCert {
+            host: self.host.clone(),
+            port: self.port,
+            sha256: leaf_sha256,
+            der: leaf_der.to_vec(),
+            subject: leaf.subject.clone(),
+            issuer: leaf.issuer.clone(),
+            not_after: leaf.not_after,
+            added_at: OffsetDateTime::now_utc(),
+        };
+        let req = TrustRequest {
+            cert,
+            platform_ok: record.platform.is_ok(),
+            details,
+            log: log.clone(),
+        };
+        match self.gate.decide(req, cancel).await {
+            Ok(source) => {
+                self.verifier.pin(leaf_sha256);
+                session.trusted_by = source;
+                log.status("TLS connection established.");
+                log.debug(3, format!("{}, {}", session.protocol, session.cipher_suite));
+                tracing::info!(session = log.session.get(), "tls established");
+                tracing::debug!(
+                    server = %self.host,
+                    sha256 = %fingerprint_hex(&leaf_sha256),
+                    trusted_by = ?source,
+                    "tls certificate accepted"
+                );
+                self.info = Some(session);
+                Ok(Box::new(stream))
+            }
+            Err(e) => {
+                // Dropped without close_notify.
+                drop(stream);
+                if matches!(e, Error::Tls(_)) {
+                    log.error("Certificate rejected");
+                    tracing::info!(session = log.session.get(), "certificate rejected");
+                }
+                Err(e)
+            }
+        }
+    }
+
+    /// A [`StreamUpgrade`] for implicit FTPS (`ControlConnection::connect`'s
+    /// pre-greeting hook).
+    pub fn implicit<'a>(
+        &'a mut self,
+        log: &SessionLog,
+        cancel: &CancellationToken,
+    ) -> ImplicitTls<'a> {
+        ImplicitTls {
+            session: tokio::sync::Mutex::new(self),
+            log: log.clone(),
+            cancel: cancel.clone(),
+        }
+    }
+
+    /// The `DataTlsHook` for T11 (same config → session resumption; the leaf is
+    /// pinned to the control connection's).
+    pub fn data_hook(&self) -> TlsDataHook {
+        TlsDataHook {
+            config: Arc::clone(&self.config),
+            server_name: self.server_name.clone(),
+            verifier: Arc::clone(&self.verifier),
+            timeout: self.timeout,
+            log: self.log.clone(),
+        }
+    }
+
+    /// T14, after a failed transfer on this session: `Err(TlsReuseRequired)` when the
+    /// server requires TLS session resumption and a TLS 1.2 reconnect may help (the
+    /// host:port is then remembered in the gate); otherwise the error to report
+    /// (`Tls(REUSE_FAILED)` for a reuse failure that TLS 1.2 cannot fix).
+    ///
+    /// # Errors
+    ///
+    /// [`TlsReuseRequired`]: reconnect with a new `TlsSession` (TLS 1.2 only) and
+    /// retry the operation once.
+    pub fn check_data_error(&self, err: Error) -> std::result::Result<Error, TlsReuseRequired> {
+        let reuse = matches!(
+            &err,
+            Error::Protocol { code: Some(code), message }
+                if (400..600).contains(code) && is_reuse_text(message)
+        );
+        if !reuse {
+            return Ok(err);
+        }
+        let tls13 = self.info.as_ref().is_some_and(|i| i.protocol == "TLSv1.3");
+        if tls13 && self.gate.mark_tls12_only(&self.host, self.port) {
+            if let Some(log) = &self.log {
+                log.status(REUSE_RECONNECT_STATUS);
+            }
+            return Err(TlsReuseRequired);
+        }
+        Ok(Error::Tls(REUSE_FAILED.into()))
+    }
+
+    fn set_data_protection(&mut self, p: DataProtection) {
+        if let Some(info) = self.info.as_mut() {
+            info.data_protection = p;
+        }
+    }
+}
+
+/// The prompt payload for a control handshake's record (pure; snapshot-tested).
+pub(crate) fn prompt_details(
+    server_name: &ServerName<'_>,
+    host: &str,
+    port: u16,
+    record: &VerifyRecord,
+    session: TlsSessionInfo,
+    now: OffsetDateTime,
+) -> CertPromptDetails {
+    let leaf: Option<&CertificateDetails> = session.chain.first();
+    let self_issued = leaf.is_some_and(|l| l.parse_error.is_none() && l.subject == l.issuer);
+    let mut hostname_matches = record
+        .chain_der
+        .first()
+        .and_then(|der| ParsedCertificate::try_from(der).ok())
+        .is_some_and(|p| verify_server_name(&p, server_name).is_ok());
+    let mut problems = Vec::new();
+    if let Err(e) = &record.platform {
+        let p = cert_problem(e, self_issued);
+        if p == CertProblem::NotValidForName {
+            hostname_matches = false;
+        }
+        problems.push(p);
+    }
+    if !hostname_matches {
+        problems.push(CertProblem::NotValidForName);
+    }
+    if let Some(l) = leaf.filter(|l| l.parse_error.is_none()) {
+        if l.not_after < now {
+            problems.push(CertProblem::Expired);
+        }
+        if l.not_before > now {
+            problems.push(CertProblem::NotYetValid);
+        }
+        if l.self_signed {
+            problems.push(CertProblem::SelfSigned);
+        }
+    }
+    let mut seen = Vec::new();
+    problems.retain(|p| {
+        if seen.contains(p) {
+            false
+        } else {
+            seen.push(p.clone());
+            true
+        }
+    });
+    CertPromptDetails {
+        host: host.to_owned(),
+        port,
+        session,
+        problems,
+        hostname_matches,
+        previous: None,
+        can_save: false,
+    }
+}
+
+/// Implicit FTPS: the TLS handshake (and trust decision) before the greeting.
+pub struct ImplicitTls<'a> {
+    session: tokio::sync::Mutex<&'a mut TlsSession>,
+    log: SessionLog,
+    cancel: CancellationToken,
+}
+
+impl fmt::Debug for ImplicitTls<'_> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("ImplicitTls").finish_non_exhaustive()
+    }
+}
+
+#[async_trait]
+impl StreamUpgrade for ImplicitTls<'_> {
+    async fn upgrade(&self, io: BoxedIo) -> Result<BoxedIo> {
+        let mut session = self.session.lock().await;
+        session.secure_control(io, &self.log, &self.cancel).await
+    }
+}
+
+/// T11's [`DataTlsHook`] for one FTPS session.
+#[derive(Clone)]
+pub struct TlsDataHook {
+    config: Arc<ClientConfig>,
+    server_name: ServerName<'static>,
+    verifier: Arc<FtpCertVerifier>,
+    timeout: Duration,
+    log: Option<SessionLog>,
+}
+
+impl fmt::Debug for TlsDataHook {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("TlsDataHook")
+            .field("server_name", &self.server_name)
+            .finish_non_exhaustive()
+    }
+}
+
+#[async_trait]
+impl DataTlsHook for TlsDataHook {
+    async fn wrap(&self, raw: RawData) -> Result<DataIo> {
+        let connector = TlsConnector::from(Arc::clone(&self.config));
+        let handshake = connector.connect(self.server_name.clone(), raw);
+        match tokio::time::timeout(self.timeout, handshake).await {
+            Err(_) => {
+                if let Some(log) = &self.log {
+                    log.error("TLS handshake on the data connection timed out");
+                }
+                Err(Error::Timeout)
+            }
+            Ok(Err(e)) => {
+                if self.verifier.take_mismatch() {
+                    if let Some(log) = &self.log {
+                        log.error("Data connection certificate differs from control connection");
+                    }
+                    return Err(Error::Tls(DATA_CERT_DIFFERS.into()));
+                }
+                if let Some(log) = &self.log {
+                    log.error(format!("TLS handshake on the data connection failed: {e}"));
+                }
+                Err(Error::Tls(format!(
+                    "TLS handshake on the data connection failed: {e}"
+                )))
+            }
+            Ok(Ok(stream)) => {
+                if let Some(log) = &self.log {
+                    let (_, conn) = stream.get_ref();
+                    let resumed = conn.handshake_kind() == Some(rustls::HandshakeKind::Resumed);
+                    log.debug(
+                        3,
+                        format!(
+                            "TLS data connection: {}, {}, {} handshake",
+                            version_name(conn.protocol_version()),
+                            conn.negotiated_cipher_suite().map_or_else(
+                                || "unknown".to_owned(),
+                                |s| format!("{:?}", s.suite())
+                            ),
+                            if resumed { "resumed" } else { "full" }
+                        ),
+                    );
+                }
+                Ok(DataIo::Tls(Box::new(stream)))
+            }
+        }
+    }
+
+    fn map_failure(&self, err: Error, reply: Option<&Reply>) -> Error {
+        match reply {
+            Some(r) if (400..600).contains(&r.code()) && is_reuse_text(&r.text()) => {
+                Error::Protocol {
+                    code: Some(r.code()),
+                    message: r.text(),
+                }
+            }
+            _ => err,
+        }
+    }
+}
+
+// ---- the T10 sequence ------------------------------------------------------------------------
+
+/// Explicit FTPS after the greeting (§1): `AUTH TLS` → `234` → handshake; refused
+/// (500/502/504/431/534) → `AUTH SSL` → `234`/`334` → handshake. Returns whether the
+/// control connection is now encrypted. `PlainOnly` sends nothing; `RequireImplicit`
+/// only checks that the implicit handshake ran.
+///
+/// # Errors
+///
+/// `Tls` (`RequireExplicit` and both refused; handshake failure — never downgraded;
+/// rejected certificate), `Connection` (`421`), `Timeout`, `Cancelled`.
+pub async fn start_tls(
+    ctrl: &mut ControlConnection,
+    session: &mut TlsSession,
+    mode: FtpEncryption,
+    cancel: &CancellationToken,
+) -> Result<bool> {
+    match mode {
+        FtpEncryption::PlainOnly => return Ok(false),
+        FtpEncryption::RequireImplicit => {
+            return if session.info().is_some() {
+                Ok(true)
+            } else {
+                Err(Error::Internal(
+                    "implicit FTPS without a TLS handshake".into(),
+                ))
+            };
+        }
+        FtpEncryption::ExplicitIfAvailable | FtpEncryption::RequireExplicit => {}
+    }
+    let log = ctrl.session_log().clone();
+    let mut accepted = false;
+    let reply = ctrl.send(Command::new("AUTH").arg("TLS")?, cancel).await?;
+    if reply.code() == 234 {
+        accepted = true;
+    } else if AUTH_REFUSED.contains(&reply.code()) {
+        let reply = ctrl.send(Command::new("AUTH").arg("SSL")?, cancel).await?;
+        accepted = matches!(reply.code(), 234 | 334);
+    }
+    if !accepted {
+        if mode == FtpEncryption::RequireExplicit {
+            log.error("Server does not support FTP over TLS");
+            return Err(Error::Tls(NO_TLS_SUPPORT.into()));
+        }
+        log.status(NO_TLS_WARNING);
+        log.debug(1, "AUTH refused, continuing without TLS");
+        tracing::info!(session = log.session.get(), "ftp continues without tls");
+        return Ok(false);
+    }
+    // A failed handshake breaks the connection: never continue in plain text.
+    ctrl.upgrade_stream(|io| session.secure_control(io, &log, cancel))
+        .await?;
+    Ok(true)
+}
+
+/// After login on a TLS control connection (§2): `PBSZ 0` (failure ignored), then
+/// `PROT P`. Refused: `ExplicitIfAvailable` → `PROT C` + warning; the other modes fail.
+///
+/// # Errors
+///
+/// `Tls(PROT_REFUSED)`, and as `ControlConnection::send`.
+pub async fn protect_data(
+    ctrl: &mut ControlConnection,
+    session: &mut TlsSession,
+    mode: FtpEncryption,
+    cancel: &CancellationToken,
+) -> Result<DataProtection> {
+    let log = ctrl.session_log().clone();
+    let pbsz = ctrl.send(Command::new("PBSZ").arg("0")?, cancel).await?;
+    if !pbsz.is_ok() {
+        log.debug(1, format!("PBSZ refused ({}), continuing", pbsz.code()));
+    }
+    let prot = ctrl.send(Command::new("PROT").arg("P")?, cancel).await?;
+    if prot.is_ok() {
+        session.set_data_protection(DataProtection::Private);
+        return Ok(DataProtection::Private);
+    }
+    if mode != FtpEncryption::ExplicitIfAvailable {
+        log.error("Server refused to encrypt data connections");
+        return Err(Error::Tls(PROT_REFUSED.into()));
+    }
+    let clear = ctrl.send(Command::new("PROT").arg("C")?, cancel).await?;
+    if !clear.is_ok() {
+        log.debug(1, format!("PROT C refused ({})", clear.code()));
+    }
+    log.status(PROT_C_WARNING);
+    session.set_data_protection(DataProtection::Clear);
+    Ok(DataProtection::Clear)
+}
