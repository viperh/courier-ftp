+/// Explicit FTPS + login against a self-signed server; returns the session.
+async fn trust_roundtrip(
+    ui: &Ui,
+    gate: &Arc<TlsTrustGate>,
+    seed: u8,
+) -> std::result::Result<TlsSession, Error> {
+    let cfg = Pki::self_signed(seed, TlsVersions::Both);
+    let (server, addr) = FakeServer::tcp(script(vec![explicit(&cfg), login_steps()])).await;
+    let log = ui.log();
+    let mut session = Pki::new().session(gate, false);
+    let (mut ctrl, r) =
+        connect_explicit(addr, &log, &mut session, FtpEncryption::RequireExplicit).await;
+    if let Err(e) = r {
+        drop(ctrl);
+        server.finish().await;
+        return Err(e);
+    }
+    login(&mut ctrl).await.unwrap();
+    done(ctrl, server).await;
+    Ok(session)
+}
