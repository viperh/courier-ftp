# Generated and compared files keep LF endings on every platform (Windows CI
# checks out with core.autocrlf=true otherwise).
*.md   text eol=lf
*.snap text eol=lf
*.json text eol=lf
*.sh   text eol=lf
# Listing fixtures are compared byte for byte (tabs, trailing spaces, CRLF,
# non-UTF-8 names): never convert them.
crates/courier-ftp-proto-ftp/tests/listings/* -text
# Binary test fixtures (encrypted envelopes): never touch line endings.
*.bin  binary
