┏▶Help: key bindings ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓
┃General                                                                                                                                                       ┃
┃?, f1              │ Help               │ Help: bindings for the current mode                                                                                 ┃
┃ctrl-q, f10        │ Quit               │ Quit (confirm when transfers run)                                                                                   ┃
┃ctrl-z             │ Suspend            │ Suspend to the shell (Unix)                                                                                         ┃
┃g r                │ Redraw             │ Clear and redraw the screen                                                                                         ┃
┃ctrl-c             │ Cancel             │ Cancel the focused pane's running operation                                                                         ┃
┃f9                 │ Settings           │ Settings                                                                                                            ┃
┃                                                                                                                                                              ┃
┃Focus                                                                                                                                                         ┃
┃tab                │ FocusOtherSide     │ Switch between local and remote list                                                                                ┃
