---
source: crates/courier-ftp/src/ui/quickconnect.rs
expression: out
---
sftp://alice@host:2222/var/www     → host="sftp://host" user="alice" pass= port="2222" dir="/var/www"
sftp://alice:s3cret@example.com    → host="sftp://example.com" user="alice" pass=•••••• port="" dir=""
ftpes://bob@ftp.example.com/pub    → host="ftpes://ftp.example.com" user="bob" pass= port="" dir="/pub"
ftps://ftp.example.com             → host="ftps://ftp.example.com" user="" pass= port="" dir=""
ftp://[::1]:2121/                  → host="ftp://[::1]" user="" pass= port="2121" dir="/"
me%40corp@host:22                  → host="host" user="me@corp" pass= port="22" dir=""
example.com                        → host="example.com" user="" pass= port="" dir=""
example.com:21                     → host="example.com" user="" pass= port="21" dir=""
::1                                → host="[::1]" user="" pass= port="" dir=""
