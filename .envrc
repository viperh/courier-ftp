# Used by direnv (https://direnv.net) to keep config, data and logs inside the
# repo while developing instead of scattering them across the user's system.
#
# COURIER_FTP_CONFIG / COURIER_FTP_DATA win over COURIER_FTP_HOME (which would move
# config, data and cache under one root). The config directory is the one holding the
# baked-in defaults, so the dev build layers them on top of themselves.
#
# The prefix is the crate name upper-cased (see `config::PROJECT_NAME`), so if
# you rename the `courier-ftp` crate you must rename these variables to match.
export COURIER_FTP_CONFIG=`pwd`/crates/courier-ftp/config
export COURIER_FTP_DATA=`pwd`/.data
export COURIER_FTP_LOG_LEVEL=debug
